--- /dev/null
+++ b/src/runtime/stall.cpp
@@ -0,0 +1,606 @@
+// Stall recorder: see stall.h.
+
+#include "runtime/stall.h"
+
+#include <pthread.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cctype>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include <dlfcn.h>
+
+#if defined(__APPLE__)
+#include <mach-o/dyld.h>
+#include <mach-o/getsect.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#endif
+
+#include "runtime/gfx/device.h"
+#include "runtime/log.h"
+#include "runtime/runtime.h"
+
+namespace recomp::stall {
+
+bool g_on = false;
+thread_local bool t_main = false;
+
+namespace {
+
+// ---- clock ------------------------------------------------------------------
+
+#if defined(__APPLE__)
+double g_ns_per_tick = 1.0;
+#if defined(__aarch64__)
+// The virtual counter, read directly (no call, no ISB: a few cycles of
+// reordering do not matter here). Its rate is CNTFRQ_EL0's, which need
+// not be mach_absolute_time's timebase.
+inline uint64_t Now() {
+  uint64_t v;
+  asm volatile("mrs %0, cntvct_el0" : "=r"(v));
+  return v;
+}
+inline double NsPerTick() {
+  uint64_t f;
+  asm volatile("mrs %0, cntfrq_el0" : "=r"(f));
+  return 1e9 / double(f);
+}
+#else
+inline double NsPerTick() {
+  mach_timebase_info_data_t tb;
+  mach_timebase_info(&tb);
+  return double(tb.numer) / double(tb.denom);
+}
+inline uint64_t Now() { return mach_absolute_time(); }
+#endif
+#else
+inline uint64_t Now() {
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return uint64_t(ts.tv_sec) * 1000000000u + uint64_t(ts.tv_nsec);
+}
+constexpr double g_ns_per_tick = 1.0;
+#endif
+inline double Ms(uint64_t ticks) { return double(ticks) * g_ns_per_tick / 1e6; }
+
+// ---- configuration ------------------------------------------------------------
+
+uint64_t g_threshold = 0;  // ticks
+unsigned g_max_reports = 200;
+const char* g_tag_expr = nullptr;
+unsigned g_test_report_ms = 0;  // <ID>_TEST_STALL_REPORT_MS: a slow report (tests)
+uint64_t g_t0 = 0;
+
+// ---- per-frame accounting (main thread only) -----------------------------------
+
+struct ImportStat {
+  const char* name;  // stable (the import slot's string); nullptr: free
+  uint64_t ticks;    // while this import was the innermost one
+  uint32_t calls;
+  bool untimed;      // counted only (kUntimed)
+  uint64_t longest;  // longest single call, entry to exit
+  uint32_t longest_ret;
+};
+constexpr int kImportSlots = 1024;
+constexpr int kMoreSlot = kImportSlots - 1;  // a full table's overflow
+ImportStat g_imp[kImportSlots];
+uint16_t g_touched[kImportSlots];
+int g_ntouched = 0;
+
+struct Level {
+  uint8_t cat;
+  int16_t imp;
+  uint64_t start;
+  uint32_t ret;
+};
+constexpr int kMaxDepth = 64;
+Level g_stack[kMaxDepth];
+int g_depth = 0;
+int g_overflow = 0;  // pushes beyond kMaxDepth, ignored symmetrically
+
+uint8_t g_cur = kHost;
+int16_t g_cur_imp = -1;
+uint64_t g_last = 0;
+
+uint64_t g_cat_ticks[kCatCount];
+uint32_t g_cat_entries[kCatCount];
+uint64_t g_file_bytes = 0;
+uint32_t g_file_ops = 0;
+bool g_pumped = false;
+
+uint64_t g_frame_start = 0;
+uint32_t g_frame = 0;
+bool g_interactive_seen = false;
+unsigned g_reports = 0;
+unsigned g_suppressed = 0;
+
+inline void Charge(uint64_t now) {
+  uint64_t d = now - g_last;
+  g_last = now;
+  g_cat_ticks[g_cur] += d;
+  if (g_cur_imp >= 0) g_imp[g_cur_imp].ticks += d;
+}
+
+int16_t SlotOf(const char* name) {
+  uint32_t h = uint32_t(reinterpret_cast<uintptr_t>(name) >> 3) * 2654435761u;
+  for (int probe = 0; probe < kImportSlots - 1; probe++) {
+    int i = int((h + uint32_t(probe)) % uint32_t(kImportSlots - 1));  // never kMoreSlot
+    if (g_imp[i].name == name) return int16_t(i);
+    if (!g_imp[i].name) {
+      if (g_ntouched >= kImportSlots * 3 / 4) break;
+      g_imp[i].name = name;
+      g_touched[g_ntouched++] = uint16_t(i);
+      return int16_t(i);
+    }
+  }
+  if (!g_imp[kMoreSlot].name) g_imp[kMoreSlot].name = "(more imports)";
+  return int16_t(kMoreSlot);
+}
+
+inline void Push(uint8_t cat, int16_t imp, uint64_t now, uint32_t ret) {
+  if (g_depth >= kMaxDepth) {
+    g_overflow++;
+    return;
+  }
+  g_stack[g_depth++] = {g_cur, g_cur_imp, now, ret};
+  g_cur = cat;
+  g_cur_imp = imp;
+}
+
+inline void Pop(uint64_t now) {
+  if (g_overflow) {
+    g_overflow--;
+    return;
+  }
+  if (!g_depth) return;
+  const Level& l = g_stack[--g_depth];
+  if (g_cur_imp >= 0 && g_cur_imp != l.imp) {
+    ImportStat& s = g_imp[g_cur_imp];
+    uint64_t dur = now - l.start;
+    if (dur > s.longest) {
+      s.longest = dur;
+      s.longest_ret = l.ret;
+    }
+  }
+  g_cur = l.cat;
+  g_cur_imp = l.imp;
+}
+
+// ---- sampler (macOS): the main thread's stack every period ----------------------
+
+constexpr int kRing = 4096;
+constexpr int kDepth = 24;
+struct Sample {
+  std::atomic<uint32_t> seq{0};  // odd while being written
+  uint64_t t = 0;
+  uint32_t n = 0;
+  uintptr_t pc[kDepth];
+};
+Sample* g_ring = nullptr;
+std::atomic<uint32_t> g_widx{0};
+uintptr_t g_lo[2], g_hi[2];  // the main thread's host stacks
+uintptr_t g_exe_lo = 0, g_exe_hi = ~uintptr_t(0);  // the executable's code (the lifted functions)
+
+#if defined(__APPLE__) && defined(__aarch64__)
+mach_port_t g_main_port = MACH_PORT_NULL;
+
+inline uintptr_t Strip(uintptr_t a) { return a & 0x00007FFFFFFFFFFFull; }
+
+inline bool FrameOk(uintptr_t fp) {
+  if (fp & 7) return false;
+  for (int i = 0; i < 2; i++)
+    if (fp >= g_lo[i] && fp + 16 <= g_hi[i]) return true;
+  return false;
+}
+
+// While the main thread is suspended: no locks, no allocation.
+void SamplerMain(unsigned period_us) {
+  // dladdr's first use is slow (its symbol tables): pay it here, not in
+  // the first report on the main thread.
+  Dl_info di;
+  dladdr(reinterpret_cast<void*>(&SamplerMain), &di);
+  dladdr(reinterpret_cast<void*>(&usleep), &di);
+  for (;;) {
+    usleep(period_us);
+    if (thread_suspend(g_main_port) != KERN_SUCCESS) continue;
+    arm_thread_state64_t st;
+    mach_msg_type_number_t cnt = ARM_THREAD_STATE64_COUNT;
+    kern_return_t kr =
+        thread_get_state(g_main_port, ARM_THREAD_STATE64, reinterpret_cast<thread_state_t>(&st), &cnt);
+    Sample& s = g_ring[g_widx.fetch_add(1, std::memory_order_relaxed) % kRing];
+    s.seq.fetch_add(1, std::memory_order_acq_rel);
+    s.t = Now();
+    uint32_t n = 0;
+    if (kr == KERN_SUCCESS) {
+      s.pc[n++] = Strip(uintptr_t(arm_thread_state64_get_pc(st)));
+      uintptr_t fp = Strip(uintptr_t(arm_thread_state64_get_fp(st)));
+      while (n < kDepth && FrameOk(fp)) {
+        const uintptr_t* f = reinterpret_cast<const uintptr_t*>(fp);
+        uintptr_t next = Strip(f[0]);
+        s.pc[n++] = Strip(f[1]);
+        if (next <= fp) break;
+        fp = next;
+      }
+    }
+    thread_resume(g_main_port);
+    s.n = n;
+    s.seq.fetch_add(1, std::memory_order_release);
+  }
+}
+#endif
+
+// The innermost lifted function (its guest VA) in a sampled stack, and the
+// innermost host function's name.
+struct Sym {
+  bool lifted;
+  uint32_t va;
+  std::string name;
+};
+std::unordered_map<uintptr_t, Sym> g_syms;  // report time only
+
+const Sym& Symbolise(uintptr_t pc) {
+  auto it = g_syms.find(pc);
+  if (it != g_syms.end()) return it->second;
+  Sym s{false, 0, "?"};
+  Dl_info di;
+  // A return address points after the call: look up the call itself.
+  if (pc && dladdr(reinterpret_cast<void*>(pc - 1), &di)) {
+    if (di.dli_sname) {
+      // Lifted functions: recomp::gen::f_<8 hex digits> (then the
+      // mangled parameters, which may start with a hex letter).
+      const char* g = std::strstr(di.dli_sname, "6recomp3gen");
+      const char* f = g ? std::strstr(g, "f_") : nullptr;
+      if (f) {
+        uint32_t va = 0;
+        int k = 0;
+        for (; k < 8 && std::isxdigit(static_cast<unsigned char>(f[2 + k])); k++)
+          va = va << 4 | uint32_t(std::isdigit(static_cast<unsigned char>(f[2 + k]))
+                                      ? f[2 + k] - '0'
+                                      : (f[2 + k] | 0x20) - 'a' + 10);
+        if (k == 8) {
+          s.lifted = true;
+          s.va = va;
+        }
+      }
+      s.name = di.dli_sname[0] == '_' ? di.dli_sname + 1 : di.dli_sname;
+    } else if (di.dli_fname) {
+      const char* b = std::strrchr(di.dli_fname, '/');
+      s.name = b ? b + 1 : di.dli_fname;
+    }
+  }
+  return g_syms.emplace(pc, std::move(s)).first->second;
+}
+
+template <class K>
+std::vector<std::pair<K, unsigned>> Top(const std::unordered_map<K, unsigned>& m, size_t n) {
+  std::vector<std::pair<K, unsigned>> v(m.begin(), m.end());
+  std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) {
+    return a.second != b.second ? a.second > b.second : a.first < b.first;
+  });
+  if (v.size() > n) v.resize(n);
+  return v;
+}
+
+std::string SampleSummary(uint64_t from, uint64_t to) {
+  if (!g_ring) return "";
+  std::unordered_map<uint32_t, unsigned> guest;
+  std::unordered_map<std::string, unsigned> host;
+  unsigned taken = 0, unlifted = 0;
+  uintptr_t pc[kDepth];
+  for (int i = 0; i < kRing; i++) {
+    Sample& s = g_ring[i];
+    uint32_t q = s.seq.load(std::memory_order_acquire);
+    if (q & 1) continue;
+    uint64_t t = s.t;
+    uint32_t n = std::min<uint32_t>(s.n, kDepth);
+    std::memcpy(pc, s.pc, sizeof(uintptr_t) * n);
+    if (s.seq.load(std::memory_order_acquire) != q || t < from || t > to || !n) continue;
+    taken++;
+    host[Symbolise(pc[0]).name]++;
+    bool found = false;
+    for (uint32_t k = 0; k < n && !found; k++) {
+      if (pc[k] < g_exe_lo || pc[k] >= g_exe_hi) continue;  // no lifted code there
+      const Sym& sy = Symbolise(pc[k]);
+      if (sy.lifted) {
+        guest[sy.va]++;
+        found = true;
+      }
+    }
+    if (!found) unlifted++;
+  }
+  char buf[96];
+  std::snprintf(buf, sizeof buf, " | samples %u", taken);
+  std::string r = buf;
+  if (!taken) return r;
+  r += ", guest fn:";
+  for (auto& [va, k] : Top(guest, 5)) {
+    std::snprintf(buf, sizeof buf, " %08X x%u", va, k);
+    r += buf;
+  }
+  if (unlifted) {
+    std::snprintf(buf, sizeof buf, " (none x%u)", unlifted);
+    r += buf;
+  }
+  r += ", host:";
+  for (auto& [name, k] : Top(host, 3)) {
+    std::snprintf(buf, sizeof buf, " x%u", k);
+    r += " " + name.substr(0, 60) + buf;
+  }
+  return r;
+}
+
+const char* const kCatNames[kCatCount] = {"host",    "guest",    "file",    "wait",    "gfx",
+                                           "audio",   "other",    "texture", "shader",  "gpu-wait",
+                                           "present", "pump",     "lock",    "recorder"};
+
+// One stall's report (recorder time: charged to the next frame).
+void Report(uint64_t from, uint64_t to, const char* phase, const uint64_t* cat, const uint32_t* entries,
+            uint64_t file_bytes, uint32_t file_ops, std::vector<ImportStat>& imps) {
+  char buf[160];
+  std::snprintf(buf, sizeof buf, "stall: frame %u took %.1f ms at t=%.2f s [%s", g_frame, Ms(to - from),
+                Ms(to - g_t0) / 1000.0, phase);
+  std::string line = buf;
+  if (g_tag_expr) {
+    uint32_t v = 0;
+    if (EvalGuestExpr(g_tag_expr, &v)) {
+      std::snprintf(buf, sizeof buf, ", tag %08X", v);
+    } else {
+      std::snprintf(buf, sizeof buf, ", tag ?");
+    }
+    line += buf;
+  }
+  line += "]:";
+  bool first = true;
+  for (int c = 0; c < kCatCount; c++) {
+    const bool counted = c >= kTexture && c <= kLock && entries[c];
+    if (Ms(cat[c]) < 0.05 && !counted) continue;
+    std::snprintf(buf, sizeof buf, "%s %s %.1f", first ? "" : ",", kCatNames[c], Ms(cat[c]));
+    line += buf;
+    if (c == kFile && file_ops) {
+      std::snprintf(buf, sizeof buf, " (%u ops, %.1f KB)", file_ops, double(file_bytes) / 1024.0);
+      line += buf;
+    } else if (counted) {
+      std::snprintf(buf, sizeof buf, " x%u", entries[c]);
+      line += buf;
+    }
+    first = false;
+  }
+  std::sort(imps.begin(), imps.end(),
+            [](const ImportStat& a, const ImportStat& b) { return a.ticks > b.ticks; });
+  line += " | imports:";
+  int shown = 0;
+  for (const ImportStat& s : imps) {
+    if (shown == 5 || Ms(s.ticks) < 0.05) break;
+    if (s.untimed) continue;
+    if (s.longest_ret) {
+      std::snprintf(buf, sizeof buf, " %s %.1f x%u (longest %.1f from %08X)", s.name, Ms(s.ticks), s.calls,
+                    Ms(s.longest), s.longest_ret);
+    } else {
+      std::snprintf(buf, sizeof buf, " %s %.1f x%u", s.name, Ms(s.ticks), s.calls);
+    }
+    line += buf;
+    shown++;
+  }
+  // Untimed imports called most (their time is in guest code).
+  std::sort(imps.begin(), imps.end(),
+            [](const ImportStat& a, const ImportStat& b) { return a.calls > b.calls; });
+  shown = 0;
+  for (const ImportStat& s : imps) {
+    if (shown == 3) break;
+    if (!s.untimed || !s.calls) continue;
+    std::snprintf(buf, sizeof buf, "%s %s x%u", shown ? "," : " | untimed:", s.name, s.calls);
+    line += buf;
+    shown++;
+  }
+  line += SampleSummary(from, to);
+  WarnF("%s\n", line.c_str());
+  if (g_test_report_ms) usleep(g_test_report_ms * 1000);
+}
+
+void FrameEndImpl() {
+  uint64_t now = Now();
+  Charge(now);
+  const uint64_t from = g_frame_start;
+  g_frame++;
+  // Calls still in progress (the present call itself, at least) count up
+  // to now in this frame's longest; the next frame times them from its start.
+  for (int i = 0; i < g_depth; i++) {
+    int16_t imp = i + 1 < g_depth ? g_stack[i + 1].imp : g_cur_imp;
+    if (imp < 0 || imp == g_stack[i].imp) continue;
+    uint64_t dur = now - std::max(g_stack[i].start, from);
+    if (dur > g_imp[imp].longest) {
+      g_imp[imp].longest = dur;
+      g_imp[imp].longest_ret = g_stack[i].ret;
+    }
+  }
+  // The recorder's own time (an earlier report) is shown, never a stall.
+  const bool stalled = now - from - g_cat_ticks[kRecorder] > g_threshold;
+  const char* phase = g_pumped ? "interactive" : g_interactive_seen ? "loading" : "startup";
+  g_interactive_seen |= g_pumped;
+  // The frame ends at `now`; what follows (the report) is the next frame's.
+  uint64_t cat[kCatCount];
+  uint32_t entries[kCatCount];
+  std::memcpy(cat, g_cat_ticks, sizeof cat);
+  std::memcpy(entries, g_cat_entries, sizeof entries);
+  const uint64_t file_bytes = g_file_bytes;
+  const uint32_t file_ops = g_file_ops;
+  std::vector<ImportStat> imps;
+  if (stalled && g_reports < g_max_reports) {
+    imps.reserve(size_t(g_ntouched) + 1);
+    for (int i = 0; i < g_ntouched; i++) imps.push_back(g_imp[g_touched[i]]);
+    if (g_imp[kMoreSlot].name) imps.push_back(g_imp[kMoreSlot]);
+  }
+  std::memset(g_cat_ticks, 0, sizeof g_cat_ticks);
+  std::memset(g_cat_entries, 0, sizeof g_cat_entries);
+  g_file_bytes = 0;
+  g_file_ops = 0;
+  g_pumped = false;
+  // Import slots of calls still in progress keep their names (the stack
+  // refers to them); only their counts restart.
+  for (int i = 0; i < g_ntouched; i++) {
+    ImportStat& s = g_imp[g_touched[i]];
+    s.ticks = 0;
+    s.calls = 0;
+    s.longest = 0;
+    s.longest_ret = 0;
+  }
+  ImportStat& more = g_imp[kMoreSlot];
+  more.ticks = more.calls = 0;
+  more.longest = more.longest_ret = 0;
+  g_frame_start = now;
+  if (!stalled) return;
+  if (g_reports >= g_max_reports) {
+    if (!g_suppressed++)
+      WarnF("stall: %u reports made; further stalls are counted, not reported\n", g_max_reports);
+    return;
+  }
+  g_reports++;
+  EnterSlow(kRecorder);
+  Report(from, now, phase, cat, entries, file_bytes, file_ops, imps);
+  LeaveSlow();
+  const uint64_t after = Now();
+  for (int i = 0; i < g_depth; i++) g_stack[i].start = after;
+}
+
+void GfxBegin(gfx::Work w) {
+  if (!t_main) return;
+  static const Cat map[] = {kTexture, kShader, kGpuWait, kPresent};
+  EnterSlow(map[int(w)]);
+}
+void GfxEnd() {
+  if (t_main) LeaveSlow();
+}
+
+}  // namespace
+
+Cat ImportCategory(const char* dll, const char* name) {
+  auto is = [&](const char* d) { return !std::strcmp(dll, d); };
+  auto any = [&](std::initializer_list<const char*> names) {
+    for (const char* n : names)
+      if (!std::strcmp(name, n)) return true;
+    return false;
+  };
+  if (is("kernel32.dll")) {
+    if (any({"TlsGetValue", "TlsSetValue", "GetLastError", "SetLastError", "GetCurrentThreadId",
+             "GetCurrentThread", "GetCurrentProcessId", "GetCurrentProcess", "GetProcessHeap", "GetTickCount",
+             "QueryPerformanceCounter", "QueryPerformanceFrequency", "InterlockedIncrement",
+             "InterlockedDecrement", "InterlockedExchange", "InterlockedCompareExchange",
+             "InterlockedExchangeAdd", "LeaveCriticalSection"}))
+      return kUntimed;
+    if (any({"CreateFileA", "CreateFileW", "ReadFile", "WriteFile", "SetFilePointer", "SetFilePointerEx",
+             "GetFileSize", "GetFileSizeEx", "FlushFileBuffers", "SetEndOfFile", "DeleteFileA",
+             "FindFirstFileA", "FindNextFileA", "FindClose", "GetFileAttributesA", "GetFileTime",
+             "SetFileTime", "CopyFileA", "MoveFileA", "CreateDirectoryA", "GetFileType"}))
+      return kFile;
+    if (any({"Sleep", "SleepEx", "WaitForSingleObject", "WaitForSingleObjectEx", "WaitForMultipleObjects",
+             "WaitForMultipleObjectsEx", "EnterCriticalSection", "GetQueuedCompletionStatus",
+             "SignalObjectAndWait"}))
+      return kWait;
+    return kOther;
+  }
+  if (is("user32.dll") && any({"MsgWaitForMultipleObjects", "MsgWaitForMultipleObjectsEx", "WaitMessage"}))
+    return kWait;
+  if (is("winmm.dll") && !std::strcmp(name, "timeGetTime")) return kUntimed;
+  if (is("opengl32.dll") || is("ddraw.dll") || is("d3d8.dll") || is("d3d9.dll") || is("gdi32.dll"))
+    return kGfx;
+  if (is("mss32.dll") || is("dsound.dll") || (is("winmm.dll") && !std::strncmp(name, "waveOut", 7)))
+    return kAudio;
+  return kOther;
+}
+
+void Init(const void* stack_lo, const void* stack_hi) {
+  t_main = true;
+  const char* e = Env("STALL");
+  const double ms = e ? std::atof(e) : 0.0;
+  if (ms <= 0) return;
+#if defined(__APPLE__)
+  g_ns_per_tick = NsPerTick();
+#endif
+  g_threshold = uint64_t(ms * 1e6 / g_ns_per_tick);
+  if (const char* m = Env("STALL_MAX")) g_max_reports = unsigned(std::atoi(m));
+  g_tag_expr = Env("STALL_TAG");
+  if (const char* t = Env("TEST_STALL_REPORT_MS")) g_test_report_ms = unsigned(std::atoi(t));
+  g_t0 = g_last = g_frame_start = Now();
+  unsigned period = 2000;
+  if (const char* p = Env("STALL_SAMPLE_US")) period = unsigned(std::atoi(p));
+  const char* sampler = "off";
+#if defined(__APPLE__) && defined(__aarch64__)
+  if (period > 0) {
+    g_ring = new Sample[kRing];
+    g_lo[0] = uintptr_t(stack_lo);
+    g_hi[0] = uintptr_t(stack_hi);
+    pthread_t self = pthread_self();
+    g_hi[1] = uintptr_t(pthread_get_stackaddr_np(self));
+    g_lo[1] = g_hi[1] - pthread_get_stacksize_np(self);
+    g_main_port = mach_thread_self();
+    unsigned long text_size = 0;
+    const auto* exe = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(0));
+    if (uint8_t* text = exe ? getsegmentdata(exe, "__TEXT", &text_size) : nullptr) {
+      g_exe_lo = uintptr_t(text);
+      g_exe_hi = g_exe_lo + text_size;
+    }
+    std::thread(SamplerMain, period).detach();
+    sampler = "on";
+  }
+#else
+  (void)stack_lo;
+  (void)stack_hi;
+#endif
+  gfx::g_work_begin = GfxBegin;
+  gfx::g_work_end = GfxEnd;
+  g_on = true;
+  WarnF("stall: recording frames over %.1f ms (sampler %s, every %u us)\n", ms, sampler, period);
+}
+
+void CountImportSlow(const char* name) {
+  ImportStat& s = g_imp[SlotOf(name)];
+  s.untimed = true;
+  s.calls++;
+}
+
+void EnterImportSlow(const char* name, Cat cat, uint32_t guest_ret) {
+  uint64_t now = Now();
+  Charge(now);
+  int16_t slot = SlotOf(name);
+  g_imp[slot].calls++;
+  Push(cat, slot, now, guest_ret);
+}
+
+void LeaveImportSlow() {
+  uint64_t now = Now();
+  Charge(now);
+  Pop(now);
+}
+
+void EnterSlow(Cat cat) {
+  uint64_t now = Now();
+  Charge(now);
+  g_cat_entries[cat]++;
+  Push(cat, cat == kGuest ? int16_t(-1) : g_cur_imp, now, 0);
+}
+
+void LeaveSlow() {
+  uint64_t now = Now();
+  Charge(now);
+  Pop(now);
+}
+
+void FileBytesSlow(uint64_t n) {
+  g_file_bytes += n;
+  g_file_ops++;
+}
+
+void PumpedSlow() { g_pumped = true; }
+
+void FrameEndSlow() { FrameEndImpl(); }
+
+}  // namespace recomp::stall
