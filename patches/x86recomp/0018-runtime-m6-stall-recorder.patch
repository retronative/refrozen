new file mode 100644
index 0000000..a8fe061
--- /dev/null
+++ b/src/runtime/stall.h
@@ -0,0 +1,110 @@
+#pragma once
+// Stall recorder (<ID>_STALL=ms, opt-in): for every presented frame that
+// took longer than ms (present to present, as <ID>_FPS_REPORT measures),
+// one report line of where the guest main thread's time went.
+//
+// Time is charged exclusively to the innermost thing the main thread is
+// doing: guest code (lifted functions), an import (by its category: file,
+// wait, graphics, audio, other), host work inside an import (texture
+// creation, shader/pipeline compilation, GPU fence waits, presentation,
+// window-system pumping, the graphics lock) or the recorder itself. The
+// categories partition the frame; the per-import list partitions its
+// non-guest time by the innermost import. Only the main thread is
+// measured; other threads show up as the main thread waiting on them.
+//
+// <ID>_STALL_SAMPLE_US=n (default 2000, 0 off; macOS): a sampler thread
+// suspends the main thread every n us and records its stack, so a stall
+// report also names the innermost lifted guest functions and host
+// functions it was seen in. <ID>_STALL_TAG=<expr> (FATAL_DUMP's syntax): a
+// guest value printed with each report, to tell game states apart.
+// <ID>_STALL_MAX=n (default 200): reports after the nth are counted only.
+//
+// Off (no <ID>_STALL), every hook is one predictable branch.
+
+#include <cstdint>
+
+namespace recomp::stall {
+
+enum Cat : uint8_t {
+  kHost,      // runtime code outside imports and guest code
+  kGuest,     // lifted guest code
+  kFile,      // file imports (CreateFile, ReadFile, ...)
+  kWait,      // sleeps, waits, critical sections
+  kGfx,       // graphics imports (opengl32, ddraw, ...), own time
+  kAudio,     // audio imports (mss32, dsound, winmm wave)
+  kOther,     // other imports
+  kTexture,   // texture creation in the graphics device
+  kShader,    // shader translation and pipeline compilation
+  kGpuWait,   // waiting for submitted GPU work
+  kPresent,   // presenting a frame (swapchain acquire, submission)
+  kPump,      // pumping window-system events
+  kLock,      // waiting for the graphics import lock
+  kRecorder,  // the recorder's own reports
+  kCatCount,
+  kUntimed = kCatCount  // pure getters (TlsGetValue, GetLastError, ...): counted, not timed
+};
+
+extern bool g_on;                    // set once, before guest code runs
+extern thread_local bool t_main;     // the guest main thread
+
+// Reads <ID>_STALL*; call once on the guest main thread before it runs
+// guest code. stack_lo/hi: that thread's host stack (for the sampler).
+void Init(const void* stack_lo, const void* stack_hi);
+
+// The category of an import, from its DLL and name (lower-case DLL);
+// kUntimed for pure getters called millions of times a second, whose
+// few nanoseconds stay in the caller's (guest) time: timing each would
+// cost more than the call and inflate exactly those frames.
+Cat ImportCategory(const char* dll, const char* name);
+
+void EnterImportSlow(const char* name, Cat cat, uint32_t guest_ret);
+void CountImportSlow(const char* name);
+void LeaveImportSlow();
+void EnterSlow(Cat cat);
+void LeaveSlow();
+void FileBytesSlow(uint64_t n);
+void PumpedSlow();
+void FrameEndSlow();
+
+// An import call (CallThunk), innermost.
+struct ImportScope {
+  bool on;
+  ImportScope(const char* name, Cat cat, uint32_t guest_ret) : on(g_on && t_main) {
+    if (!on) return;
+    if (cat == kUntimed) {
+      CountImportSlow(name);
+      on = false;
+      return;
+    }
+    EnterImportSlow(name, cat, guest_ret);
+  }
+  ~ImportScope() {
+    if (on) LeaveImportSlow();
+  }
+};
+
+// Guest code called from the host (CallGuest), or host work of category c.
+struct Scope {
+  bool on;
+  explicit Scope(Cat c) : on(g_on && t_main) {
+    if (on) EnterSlow(c);
+  }
+  ~Scope() {
+    if (on) LeaveSlow();
+  }
+};
+
+// Bytes moved by a file read or write on the main thread.
+inline void FileBytes(uint64_t n) {
+  if (g_on && t_main) FileBytesSlow(n);
+}
+// The guest pumped its message queue (PeekMessage/GetMessage).
+inline void Pumped() {
+  if (g_on && t_main) PumpedSlow();
+}
+// A frame was presented (end of PresentFrame).
+inline void FrameEnd() {
+  if (g_on && t_main) FrameEndSlow();
+}
+
+}  // namespace recomp::stall
