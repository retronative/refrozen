+// The lifted DLLs an image imports statically, in import order, once each.
+std::vector<Module*> LiftedImports(const PeImage& img) {
+  std::vector<Module*> out;
+  for (const PeImport& imp : img.imports)
+    if (Module* m = LiftedDll(imp.dll))
+      if (std::find(out.begin(), out.end(), m) == out.end()) out.push_back(m);
+  return out;
+}
+
+// Loads lifted DLL m as the Windows loader does: the lifted DLLs it imports
+// first (each counted once more), then its DllMain. `pin`: a static load,
+// never unloaded. Under g_loader_mu. False if a DllMain failed.
+bool LoadLifted(Ctx& c, Module& m, bool pin) {
+  if (pin) m.pinned = true;
+  if (m.refs++) return true;
+  if (m.stale) MapModule(m);
+  for (Module* dep : LiftedImports(m.img))
+    if (!LoadLifted(c, *dep, pin)) {
+      m.refs = 0;
+      return false;
+    }
+  if (!CallDllMain(c, m, kDllProcessAttach)) {
+    m.refs = 0;
+    return false;
+  }
+  return true;
+}
+
+// FreeLibrary's side: the last reference runs DllMain(DETACH), then
+// releases the lifted DLLs it imported. Pinned (static) loads stay.
+void ReleaseLifted(Ctx& c, Module& m) {
+  if (m.pinned || !m.refs || --m.refs) return;
+  CallDllMain(c, m, kDllProcessDetach);
+  for (Module* dep : LiftedImports(m.img)) ReleaseLifted(c, *dep);
+}
