+             "lifted_dlls)", dll.c_str(), name.c_str(), m.name.c_str());
+    const bool by_ordinal = !name.empty() && name[0] == '#';
+    const uint32_t ordinal = by_ordinal ? uint32_t(std::stoul(name.substr(1))) : 0;
