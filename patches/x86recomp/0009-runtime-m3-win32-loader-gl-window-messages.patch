+// (root, sectors per cluster, bytes per sector, free clusters, total
+// clusters). Drive C is one volume: the host volume of the per-user tree,
+// where the guest's writes go. Like NT, any existing path on the drive
+// names its volume; NULL is the current drive. NT reports up to 2^32-1
+// clusters.
+HLE("kernel32.dll", GetDiskFreeSpaceA, 5) {
+  std::string g = Arg(c, 0) ? GStr(Arg(c, 0)) : std::string("\\");
+  if (g.empty() || AbsGuest(g)[0] != 'C') {
+    SetLastError(3);  // ERROR_PATH_NOT_FOUND: no such drive
+    return 0;
+  }
+  struct stat st;
+  if (stat(HostPath(g).c_str(), &st) != 0) {
+    SetLastError(ErrnoToWin(errno));
+    return 0;
+  }
+  struct statvfs v;
+  if (statvfs(UserDataRoot().c_str(), &v) != 0) {
+    SetLastError(ErrnoToWin(errno));
+    return 0;
+  }
+  constexpr uint64_t kSector = 512;
+  const uint64_t cluster = std::max<uint64_t>(v.f_frsize, kSector);
+  auto clusters = [&](uint64_t blocks) {
+    return uint32_t(std::min<uint64_t>(blocks * v.f_frsize / cluster, 0xFFFFFFFFu));
+  };
+  if (Arg(c, 1)) Wr32(Arg(c, 1), uint32_t(cluster / kSector));
+  if (Arg(c, 2)) Wr32(Arg(c, 2), uint32_t(kSector));
+  if (Arg(c, 3)) Wr32(Arg(c, 3), clusters(v.f_bavail));
+  if (Arg(c, 4)) Wr32(Arg(c, 4), clusters(v.f_blocks));
+  return 1;
+}
