+  };
+  std::deque<Packet> queue;  // under g_wait_mu
+};
+
+constexpr uint32_t kInvalidHandleValue = 0xFFFFFFFF;
+
+// (file, existing port, key, concurrent threads).
+HLE("kernel32.dll", CreateIoCompletionPort, 4) {
+  uint32_t file = Arg(c, 0), existing = Arg(c, 1);
+  if (file != kInvalidHandleValue)
+    FatalF("CreateIoCompletionPort(file %08X): associating a handle (overlapped I/O) is not "
+           "implemented", file);
+  if (existing) {
+    SetLastError(kErrorInvalidParameter);
+    return 0;
+  }
+  return NewHandle(std::make_shared<CompletionPort>());
+}
+
+// (port, bytes, key, overlapped).
+HLE("kernel32.dll", PostQueuedCompletionStatus, 4) {
+  GuestSyncPoint sync;
+  auto port = std::dynamic_pointer_cast<CompletionPort>(GetHandle(Arg(c, 0)));
+  if (!port) {
+    SetLastError(kErrorInvalidHandle);
+    return 0;
+  }
+  {
+    std::lock_guard<std::mutex> l(g_wait_mu);
+    port->queue.push_back({Arg(c, 1), Arg(c, 2), Arg(c, 3)});
+  }
+  SignalChanged();
+  return 1;
+}
+
+// (port, &bytes, &key, &overlapped, timeout): TRUE with the oldest packet;
+// on timeout FALSE, *overlapped = NULL and WAIT_TIMEOUT.
+HLE("kernel32.dll", GetQueuedCompletionStatus, 5) {
+  GuestSyncPoint sync;
+  uint32_t bytes = Arg(c, 1), key = Arg(c, 2), ovl = Arg(c, 3), timeout = Arg(c, 4);
+  auto port = std::dynamic_pointer_cast<CompletionPort>(GetHandle(Arg(c, 0)));
+  if (!port) {
+    SetLastError(kErrorInvalidHandle);
+    return 0;
+  }
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout);
+  std::unique_lock<std::mutex> l(g_wait_mu);
+  while (port->queue.empty()) {
+    bool expired = timeout == 0 ||
+                   (timeout != kInfinite &&
+                    g_wait_cv.wait_until(l, deadline) == std::cv_status::timeout);
+    if (timeout == kInfinite) g_wait_cv.wait(l);
+    if (expired && port->queue.empty()) {
+      Wr32(ovl, 0);
+      SetLastError(kWaitTimeout);
+      return 0;
+    }
+  }
+  CompletionPort::Packet p = port->queue.front();
+  port->queue.pop_front();
+  Wr32(bytes, p.bytes);
+  Wr32(key, p.key);
+  Wr32(ovl, p.overlapped);
+  return 1;
+}
