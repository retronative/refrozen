+// ---- WIN.INI (GetProfileString) ----------------------------------------------
+
+std::string TrimBlanks(const std::string& s) {
+  size_t b = s.find_first_not_of(" \t\r"), e = s.find_last_not_of(" \t\r");
+  return b == std::string::npos ? std::string() : s.substr(b, e - b + 1);
+}
+
+// The value of [section] key= in the guest's C:\WINDOWS\win.ini; false if
+// absent (a missing file has no keys). Names compare case-insensitively; a
+// value in matching single or double quotes loses them.
+bool WinIniValue(const std::string& section, const std::string& key, std::string* out) {
+  std::ifstream f(HostPath("C:\\WINDOWS\\win.ini"));
+  std::string line;
+  bool in_section = false;
+  while (std::getline(f, line)) {
+    std::string t = TrimBlanks(line);
+    if (!t.empty() && t[0] == '[') {
+      size_t end = t.find(']');
+      in_section = end != std::string::npos && Lower(TrimBlanks(t.substr(1, end - 1))) == Lower(section);
+      continue;
+    }
+    size_t eq = t.find('=');
+    if (!in_section || eq == std::string::npos || Lower(TrimBlanks(t.substr(0, eq))) != Lower(key))
+      continue;
+    std::string v = TrimBlanks(t.substr(eq + 1));
+    if (v.size() >= 2 && (v[0] == '"' || v[0] == '\'') && v.back() == v[0]) v = v.substr(1, v.size() - 2);
+    *out = v;
+    return true;
+  }
+  return false;
+}
+
+// (section, key, default, buffer, size): the value or the default (NULL:
+// "", trailing blanks dropped), truncated to size - 1 characters; returns
+// the characters copied. Listing sections or keys (NULL section/key) is
+// not implemented.
+HLE("kernel32.dll", GetProfileStringA, 5) {
+  uint32_t app = Arg(c, 0), key = Arg(c, 1), def = Arg(c, 2), buf = Arg(c, 3), size = Arg(c, 4);
+  if (!app || !key) FatalF("GetProfileStringA: enumerating sections or keys is not implemented");
+  if (!size) return 0;
+  std::string v;
+  if (!WinIniValue(GStr(app), GStr(key), &v)) {
+    v = def ? GStr(def) : std::string();
+    v = v.substr(0, v.find_last_not_of(' ') + 1);
+  }
+  v = v.substr(0, size - 1);
+  PutStr(buf, v);
+  return uint32_t(v.size());
+}
+
 }  // namespace
 }  // namespace recomp::hle
