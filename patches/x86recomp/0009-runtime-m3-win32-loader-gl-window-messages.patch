+// imm32: the input method manager of a system without East Asian language
+// support (Windows XP en-US default), where IMM is disabled
+// (GetSystemMetrics(SM_IMMENABLED) = 0). Windows' imm32 then has no input
+// contexts: getting or associating one gives NULL/FALSE, and every call on
+// a NULL HIMC fails. No error code is set, as there.
+
+#include "runtime/hle/hle.h"
+
+namespace recomp::hle {
+namespace {
+
+HLE("imm32.dll", ImmGetContext, 1) { return 0; }             // HIMC NULL
+HLE("imm32.dll", ImmReleaseContext, 2) { return 1; }         // always TRUE
+HLE("imm32.dll", ImmAssociateContext, 2) { return 0; }       // previous HIMC: none
+HLE("imm32.dll", ImmAssociateContextEx, 3) { return 0; }     // FALSE: IMM disabled
+HLE("imm32.dll", ImmGetOpenStatus, 1) { return 0; }
+HLE("imm32.dll", ImmNotifyIME, 4) { return 0; }
+HLE("imm32.dll", ImmGetConversionStatus, 3) { return 0; }    // outputs untouched
+HLE("imm32.dll", ImmGetCompositionStringA, 4) { return 0; }  // no composition
+HLE("imm32.dll", ImmGetCandidateListA, 4) { return 0; }      // no candidates
+
+}  // namespace
+}  // namespace recomp::hle
