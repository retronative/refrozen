+static bool IsTableJmp(const Insn& jmp) {
+  const auto& m = jmp.ops[0];
+  return jmp.ok && jmp.d.mnemonic == ZYDIS_MNEMONIC_JMP &&
+         m.type == ZYDIS_OPERAND_TYPE_MEMORY && m.mem.base == ZYDIS_REGISTER_NONE &&
+         m.mem.index != ZYDIS_REGISTER_NONE && m.mem.scale == 4;
+}
+
+// A switch whose index range the compiler proved has no bound check in
+// front of its jmp. In an image with base relocations the table still has
+// exact limits: its slots are the run of relocated dwords at the table
+// address, each pointing back into this function's code before the table
+// (MSVC emits the cases, then the table). The run ends at the first slot
+// that is not relocated (the next function's code, a byte index table) or
+// whose target lies outside [entry, table).
+static bool RecoverRelocatedTable(const Program& p, const Function& f, const Insn& jmp,
+                                  std::vector<uint32_t>* targets) {
+  const Module* mod = p.TextOf(jmp.va);
+  const auto& relocs = mod->img.relocs;
+  const uint32_t table = static_cast<uint32_t>(jmp.ops[0].mem.disp.value);
+  targets->clear();
+  for (uint32_t slot = table;; slot += 4) {
+    if (!std::binary_search(relocs.begin(), relocs.end(), slot)) break;
+    uint32_t t = p.mem.read<uint32_t>(slot);
+    if (p.TextOf(t) != mod || t < f.entry || t >= table) break;
+    if (std::find(targets->begin(), targets->end(), t) == targets->end())
+      targets->push_back(t);
+  }
+  return !targets->empty();
+}
