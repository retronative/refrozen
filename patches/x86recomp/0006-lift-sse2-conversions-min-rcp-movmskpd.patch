+void CvtFloat(Ctx& c, Cvt kind, Xmm& d, const Xmm& s, uint32_t va) {
+  Scope sc(c, va);
+  Xmm r = d;
+  switch (kind) {
+    case Cvt::Ss2sd:
+      SetLane<uint64_t>(r, 0, WidenLane(sc, Lane<uint32_t>(s, 0)));
+      break;
+    case Cvt::Sd2ss:
+      SetLane<uint32_t>(r, 0, NarrowLane(sc, Lane<uint64_t>(s, 0)));
+      break;
+    case Cvt::Ps2pd:
+      for (int i = 0; i < 2; i++) SetLane<uint64_t>(r, i, WidenLane(sc, Lane<uint32_t>(s, i)));
+      break;
+    case Cvt::Pd2ps:
+      r = Xmm{};
+      for (int i = 0; i < 2; i++) SetLane<uint32_t>(r, i, NarrowLane(sc, Lane<uint64_t>(s, i)));
+      break;
+  }
+  sc.Finish();
+  d = r;
+}
+
+void Min(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint32_t va) {
+  if (dbl)
+    MinT<true>(c, lanes, d, s, va);
+  else
+    MinT<false>(c, lanes, d, s, va);
+}
+
+uint32_t RcpLane(uint32_t x) {
+  const uint32_t exp = (x >> 23) & 0xFF, frac = x & 0x7FFFFF, sign = x & 0x80000000u;
+  if (exp == 0xFF && frac) return x | 0x00400000u;  // NaN: quieted
+  if (exp == 0) return sign | 0x7F800000u;          // ±0, denormal: ±inf
+  if (exp == 0xFF) return sign;                     // ±inf: ±0
+  const uint_fast8_t mode = softfloat_roundingMode, flags = softfloat_exceptionFlags;
+  softfloat_roundingMode = softfloat_round_near_even;
+  uint32_t r = f32_div(float32_t{0x3F800000u}, float32_t{x}).v;
+  softfloat_roundingMode = mode;
+  softfloat_exceptionFlags = flags;
+  if (!(r & 0x7F800000u)) r = sign;  // below the smallest normal: flushed to ±0
+  return r;
+}
+
+void Rcpss(Xmm& d, const Xmm& s) { SetLane<uint32_t>(d, 0, RcpLane(Lane<uint32_t>(s, 0))); }
