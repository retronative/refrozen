+// One float lane to double (exact) and one double lane to float (rounded
+// per MXCSR). NaNs keep their sign and the top of their payload, quieted.
+uint64_t WidenLane(Scope& sc, uint32_t a) {
+  if (IsNaN<false>(a)) {
+    if (IsSNaN<false>(a)) sc.flags |= kIE;
+    return uint64_t(a & 0x80000000u) << 32 | 0x7FF8000000000000ull |
+           uint64_t(a & 0x007FFFFFu) << 29;
+  }
+  sc.Operand<false>(a);
+  sc.Begin();
+  uint64_t r = f32_to_f64(float32_t{a}).v;
+  sc.End();
+  return r;
+}
+uint32_t NarrowLane(Scope& sc, uint64_t a) {
+  if (IsNaN<true>(a)) {
+    if (IsSNaN<true>(a)) sc.flags |= kIE;
+    return uint32_t(a >> 32 & 0x80000000u) | 0x7FC00000u |
+           uint32_t((a & 0x000FFFFFFFFFFFFFull) >> 29);
+  }
+  sc.Operand<true>(a);
+  sc.Begin();
+  uint32_t r = f64_to_f32(float64_t{a}).v;
+  sc.End();
+  return r;
+}
+
+template <bool D>
+void MinT(Ctx& c, int lanes, Xmm& d, const Xmm& s, uint32_t va) {
+  using U = typename Fmt<D>::U;
+  Scope sc(c, va);
+  Xmm r = d;
+  for (int i = 0; i < lanes; i++) {
+    U a = Lane<U>(d, i), b = Lane<U>(s, i);
+    if (IsNaN<D>(a) || IsNaN<D>(b)) {
+      sc.flags |= kIE;  // MIN/MAX signal on QNaN operands as well
+      SetLane<U>(r, i, b);
+      continue;
+    }
+    sc.Operand<D>(a);
+    sc.Operand<D>(b);
+    SetLane<U>(r, i, Order<D>(a, b) < 0 ? a : b);  // equal, or both zeros: b
+  }
+  sc.Finish();
+  d = r;
+}
