diff --git a/src/runtime/lifted.h b/src/runtime/lifted.h
index bdcbb82..549c1d2 100644
--- a/src/runtime/lifted.h
+++ b/src/runtime/lifted.h
@@ -394,6 +394,30 @@ inline T* AtomicPtr(uint8_t* b, uint32_t a) {
   return reinterpret_cast<T*>(b + a);
 }
 
+// One seq_cst compare-and-swap; returns the value memory held, which is
+// `expected` exactly when `desired` was stored (lock cmpxchg, cmpxchg8b).
+template <typename T>
+[[gnu::always_inline]] inline T CasSeen(T* p, T expected, T desired) {
+  __atomic_compare_exchange_n(p, &expected, desired, false, __ATOMIC_SEQ_CST,
+                              __ATOMIC_SEQ_CST);
+  return expected;
+}
+
+// cmpxchg8b m64: if edx:eax equals [p], store ecx:ebx and set ZF; otherwise
+// load [p] into edx:eax and clear ZF. No other flag changes. Atomic with or
+// without lock, which is stronger than unlocked x86 needs.
+[[gnu::always_inline]] inline void Cmpxchg8b(Flags& f, uint64_t* p,
+                                             uint32_t& eax, uint32_t& edx,
+                                             uint32_t ebx, uint32_t ecx) {
+  const uint64_t want = (uint64_t(edx) << 32) | eax;
+  const uint64_t seen = CasSeen(p, want, (uint64_t(ecx) << 32) | ebx);
+  f.zf = seen == want;
+  if (!f.zf) {
+    eax = uint32_t(seen);
+    edx = uint32_t(seen >> 32);
+  }
+}
+
 }  // namespace lift
 }  // namespace recomp
 
