 #include <netinet/tcp.h>
 #include <poll.h>
@@ -48,6 +49,7 @@
 
 #include "runtime/hle/hle.h"
 #include "runtime/hle/kernel32_state.h"
+#include "runtime/hle/lan_broadcast.h"
 #include "runtime/hle/win32.h"
 #include "runtime/lazy_mem.h"
 #include "runtime/log.h"
@@ -414,6 +416,29 @@ uint32_t Receive(Ctx& c, uint32_t from, uint32_t fromlen) {  // recv / recvfrom
   return uint32_t(n);
 }
 
+// One datagram to `addr`. <ID>_TEST_NO_LIMITED_BROADCAST=1 (test aid) refuses
+// 255.255.255.255 as macOS does when a VPN is the primary service.
+ssize_t SendTo(int fd, const void* data, size_t len, int flags, sockaddr_in a, uint32_t addr) {
+  static const bool refuse_limited = Env("TEST_NO_LIMITED_BROADCAST") != nullptr;
+  if (refuse_limited && addr == htonl(INADDR_BROADCAST)) {
+    errno = EADDRNOTAVAIL;
+    return -1;
+  }
+  a.sin_addr.s_addr = addr;
+  return ::sendto(fd, data, len, flags, reinterpret_cast<sockaddr*>(&a), sizeof a);
+}
+
+// A LAN discovery broadcast (lan_broadcast.h) goes to each local network's
+// broadcast address.
+ssize_t SendLanDiscovery(int fd, const void* data, size_t len, int flags, const sockaddr_in& a) {
+  std::vector<uint32_t> targets;
+  if (ifaddrs* list = nullptr; getifaddrs(&list) == 0) {
+    targets = LanBroadcastTargets(list);
+    freeifaddrs(list);
+  }
+  return SendLanBroadcast(targets, len, [&](uint32_t addr) { return SendTo(fd, data, len, flags, a, addr); });
+}
+
 uint32_t Transmit(Ctx& c, uint32_t to, uint32_t tolen) {  // send / sendto
   Sock s;
   if (!Find(Arg(c, 0), &s)) return Fail(kWsaEnotsock);
@@ -425,7 +450,9 @@ uint32_t Transmit(Ctx& c, uint32_t to, uint32_t tolen) {  // send / sendto
     sockaddr_in a;
     uint32_t err;
     if (!ToHost(to, tolen, &a, &err)) return Fail(err);
-    n = ::sendto(s.fd, len ? GPtr(buf) : nullptr, len, int(flags), reinterpret_cast<sockaddr*>(&a), sizeof a);
+    const void* data = len ? GPtr(buf) : nullptr;
+    n = IsLanDiscovery(a.sin_addr.s_addr, a.sin_port) ? SendLanDiscovery(s.fd, data, len, int(flags), a)
+                                                       : SendTo(s.fd, data, len, int(flags), a, a.sin_addr.s_addr);
   } else {
     n = ::send(s.fd, len ? GPtr(buf) : nullptr, len, int(flags));  // a stream ignores the address
