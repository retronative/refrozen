diff --git a/src/runtime/hle/lan_broadcast.cpp b/src/runtime/hle/lan_broadcast.cpp
new file mode 100644
index 0000000..af329e4
--- /dev/null
+++ b/src/runtime/hle/lan_broadcast.cpp
@@ -0,0 +1,50 @@
+#include "runtime/hle/lan_broadcast.h"
+
+#include <arpa/inet.h>
+#include <net/if.h>
+#include <netinet/in.h>
+
+#include <algorithm>
+#include <cerrno>
+
+namespace recomp {
+namespace hle {
+
+bool IsLanDiscovery(uint32_t addr, uint16_t port) {
+  return addr == htonl(INADDR_BROADCAST) && port == htons(kLanDiscoveryPort);
+}
+
+std::vector<uint32_t> LanBroadcastTargets(const ifaddrs* list) {
+  std::vector<uint32_t> out;
+  for (const ifaddrs* i = list; i; i = i->ifa_next) {
+    const unsigned f = i->ifa_flags;
+    if (!(f & IFF_UP) || !(f & IFF_RUNNING) || !(f & IFF_BROADCAST)) continue;
+    if (f & (IFF_LOOPBACK | IFF_POINTOPOINT)) continue;
+    if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET) continue;
+    // ifa_broadaddr is ifa_dstaddr: the broadcast address with IFF_BROADCAST.
+    if (!i->ifa_broadaddr || i->ifa_broadaddr->sa_family != AF_INET) continue;
+    const uint32_t b = reinterpret_cast<const sockaddr_in*>(i->ifa_broadaddr)->sin_addr.s_addr;
+    if (b == htonl(INADDR_ANY) || b == htonl(INADDR_BROADCAST)) continue;
+    if (std::find(out.begin(), out.end(), b) == out.end()) out.push_back(b);
+  }
+  return out;
+}
+
+ssize_t SendLanBroadcast(const std::vector<uint32_t>& targets, size_t len,
+                         const std::function<ssize_t(uint32_t)>& send_to) {
+  if (targets.empty()) return send_to(htonl(INADDR_BROADCAST));
+  bool sent = false;
+  int first_error = 0;
+  for (uint32_t t : targets) {
+    if (send_to(t) >= 0)
+      sent = true;
+    else if (!first_error)
+      first_error = errno;
+  }
+  if (sent) return ssize_t(len);
+  errno = first_error;
+  return -1;
+}
+
+}  // namespace hle
+}  // namespace recomp
diff --git a/src/runtime/hle/lan_broadcast.h b/src/runtime/hle/lan_broadcast.h
new file mode 100644
index 0000000..c111a53
--- /dev/null
+++ b/src/runtime/hle/lan_broadcast.h
@@ -0,0 +1,38 @@
+#pragma once
+// Warcraft III's LAN discovery broadcasts on UDP 6112 go to 255.255.255.255,
+// which macOS routes by the primary service: with a VPN there, into its
+// tunnel, which refuses them (EADDRNOTAVAIL), and no game is seen. Such a
+// datagram goes instead to the broadcast address of each local network;
+// receivers bound to INADDR_ANY take it alike (they do on Windows too).
+// Kept apart from the socket layer so the decisions can be tested alone.
+
+#include <ifaddrs.h>
+#include <sys/types.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace recomp {
+namespace hle {
+
+inline constexpr uint16_t kLanDiscoveryPort = 6112;
+
+// A datagram to 255.255.255.255:6112 (port and address in network order).
+bool IsLanDiscovery(uint32_t addr, uint16_t port);
+
+// The broadcast address (network order) of each IPv4 interface in `list`
+// (getifaddrs) that is up and running, broadcast-capable, neither loopback
+// nor point-to-point, and has a broadcast address other than 0.0.0.0 and
+// 255.255.255.255; each address once, in list order.
+std::vector<uint32_t> LanBroadcastTargets(const ifaddrs* list);
+
+// Sends a `len`-byte datagram to each target with send_to(address); with no
+// target, to 255.255.255.255. Returns len if one send did, else -1 with
+// errno the first failure's.
+ssize_t SendLanBroadcast(const std::vector<uint32_t>& targets, size_t len,
+                         const std::function<ssize_t(uint32_t)>& send_to);
+
+}  // namespace hle
+}  // namespace recomp
