+// The GL context's fog (runtime/gl/context.h): what reaches the device
+// for glFog and GL_FOG.
+//
+// A recording gfx::Device keeps the render states and transforms in effect
+// at each draw. The fog factor the device will compute for a vertex is
+// worked out from them with D3D9's vertex-fog rules (fixed-function
+// pipeline: view-space depth z, or with D3DRS_RANGEFOGENABLE the distance
+// from the eye; LINEAR (end - d) / (end - start), EXP e^(-density d), EXP2
+// e^(-(density d)^2), clamped to [0, 1]) and compared with GL 1.5's
+// (section 3.10: c is the eye-coordinate distance from the eye, which GL
+// may approximate by |z_e|; the same three equations). Points are placed
+// where their eye-space position is evident: on the -z axis, after a
+// translation or a 90-degree rotation about y; an off-axis point may give
+// any factor between the |z_e| and exact-distance ones.
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <vector>
+
+#include "runtime/gl/context.h"
+#include "runtime/log.h"
+
+namespace recomp {
+bool g_trace = false;
+void FatalF(const char* fmt, ...) {
+  va_list a;
+  va_start(a, fmt);
+  std::vfprintf(stderr, fmt, a);
+  va_end(a);
+  std::abort();
+}
+void WarnF(const char*, ...) {}
+void TraceF(const char*, ...) {}
+}  // namespace recomp
+
+namespace {
+
+using namespace recomp;
+namespace g = recomp::gl;
+
+// Device (D3D9) render state numbers.
+constexpr uint32_t kFogEnable = 28, kFogColor = 34, kFogTableMode = 35, kFogStart = 36,
+                   kFogEnd = 37, kFogDensity = 38, kRangeFog = 48, kFogVertexMode = 140;
+
+class RecordingDevice final : public gfx::Device {
+ public:
+  // The render states and transforms in effect at each draw.
+  struct DrawState {
+    std::map<uint32_t, uint32_t> rs;
+    std::array<float, 16> world, view;
+    std::vector<uint8_t> verts;
+    uint32_t stride;
+  };
+  std::vector<DrawState> draws;
+  std::map<uint32_t, uint32_t> rs;
+  std::map<uint32_t, std::array<float, 16>> xf;
+
+  void ResetSwapChain(int, int, bool) override {}
+  gfx::TextureId CreateTexture(int, int, int, gfx::Format, bool) override { return ++ids_; }
+  void DestroyTexture(gfx::TextureId) override {}
+  void FillTexture(gfx::TextureId, const gfx::Rect&, uint32_t) override {}
+  void UpdateTexture(gfx::TextureId, int, const gfx::Rect&, const void*, uint32_t) override {}
+  gfx::TextureId CreateCubeTexture(int, int, gfx::Format) override { return ++ids_; }
+  void UpdateCubeTexture(gfx::TextureId, int, int, const gfx::Rect&, const void*, uint32_t) override {}
+  gfx::DepthId CreateDepth(int, int, gfx::Format) override { return 1; }
+  void DestroyDepth(gfx::DepthId) override {}
+  void SetRenderTarget(gfx::TextureId, gfx::DepthId) override {}
+  void SetRenderTargets(const gfx::ColorTarget*, gfx::DepthId) override {}
+  void StretchRect(gfx::ColorTarget, const gfx::Rect&, gfx::ColorTarget, const gfx::Rect&, bool) override {}
+  gfx::ShaderId CreateShader(const hlsl::Program&) override { return 0; }
+  void DestroyShader(gfx::ShaderId) override {}
+  void DrawShader(const gfx::ShaderDraw&) override {}
+  void Blit(const void*, uint32_t, gfx::Format, const gfx::Rect&, const gfx::Rect&, bool,
+            uint32_t) override {}
+  void ReadBack(const gfx::Rect&, void*, uint32_t, gfx::Format) override {}
+  void BlitBlend(const void*, uint32_t, const gfx::Rect&, const gfx::Rect&) override {}
+  uint32_t StartReadBack(const gfx::Rect&) override { return 1; }
+  void FinishReadBack(uint32_t, void*, uint32_t, gfx::Format) override {}
+  void BlitFront(const void*, uint32_t, gfx::Format, const gfx::Rect&,
+                 const gfx::Rect&) override {}
+  void ReadBackFront(const gfx::Rect&, void*, uint32_t, gfx::Format) override {}
+  void PresentFront() override {}
+  void SetRenderState(uint32_t s, uint32_t v) override { rs[s] = v; }
+  void SetTextureStageState(uint32_t, uint32_t, uint32_t) override {}
+  void SetTexture(uint32_t, gfx::TextureId) override {}
+  void SetTransform(uint32_t t, const float* m) override { std::copy_n(m, 16, xf[t].begin()); }
+  void SetViewport(const gfx::Viewport&) override {}
+  void SetScissor(const gfx::Rect&) override {}
+  void SetMaterial(const gfx::Material&) override {}
+  void SetLight(uint32_t, const gfx::Light&) override {}
+  void LightEnable(uint32_t, bool) override {}
+  void SetClipPlane(uint32_t, const float*) override {}
+  void Clear(uint32_t, const gfx::Rect*, uint32_t, uint32_t, float, uint32_t) override {}
+  void BeginScene() override {}
+  void EndScene() override {}
+  void Draw(uint32_t, uint32_t, const void* v, uint32_t nv, uint32_t stride, const uint16_t*,
+            uint32_t) override {
+    auto* b = static_cast<const uint8_t*>(v);
+    draws.push_back({rs, xf[1], xf[2], {b, b + size_t(nv) * stride}, stride});
+  }
+  Mapped MapDraw(uint32_t nv, uint32_t stride, uint32_t ni) override {
+    map_v_.assign(size_t(nv) * stride, 0);
+    map_i_.assign(ni, 0);
+    map_stride_ = stride;
+    return {map_v_.data(), map_i_.data()};
+  }
+  void DrawMapped(uint32_t, uint32_t) override {
+    draws.push_back({rs, xf[1], xf[2], map_v_, map_stride_});
+  }
+  void Present() override {}
+
+ private:
+  uint32_t ids_ = 0;
+  std::vector<uint8_t> map_v_;
+  std::vector<uint16_t> map_i_;
+  uint32_t map_stride_ = 0;
+};
+
+
+int g_failures = 0;
+
+void Expect(const char* what, bool ok) {
+  if (!ok) {
+    std::printf("FAIL %s\n", what);
+    g_failures++;
+  }
+}
+
+float AsFloat(uint32_t v) {
+  float f;
+  std::memcpy(&f, &v, 4);
+  return f;
+}
+
+// The factor the device computes for the draw's first vertex.
+float DeviceFog(const RecordingDevice::DrawState& d) {
+  float p[3];
+  std::memcpy(p, d.verts.data(), 12);
+  // Row vector times WORLD, then VIEW (D3D9's convention, matrices row-major).
+  float w[4], v[4];
+  for (int j = 0; j < 4; j++)
+    w[j] = p[0] * d.world[j] + p[1] * d.world[4 + j] + p[2] * d.world[8 + j] + d.world[12 + j];
+  for (int j = 0; j < 4; j++)
+    v[j] = w[0] * d.view[j] + w[1] * d.view[4 + j] + w[2] * d.view[8 + j] + w[3] * d.view[12 + j];
+  auto rs = [&](uint32_t s) { auto it = d.rs.find(s); return it == d.rs.end() ? 0u : it->second; };
+  float x = v[0] / v[3], y = v[1] / v[3], z = v[2] / v[3];
+  float dist = rs(kRangeFog) ? std::sqrt(x * x + y * y + z * z) : z;
+  float start = AsFloat(rs(kFogStart)), end = AsFloat(rs(kFogEnd)), dens = AsFloat(rs(kFogDensity));
+  float f;
+  switch (rs(kFogVertexMode)) {
+    case 3: f = (end - dist) / (end - start); break;
+    case 1: f = std::exp(-dens * dist); break;
+    case 2: f = std::exp(-(dens * dist) * (dens * dist)); break;
+    default: return -1;
+  }
+  return std::clamp(f, 0.0f, 1.0f);
+}
+
+struct Case {
+  const char* name;
+  g::Enum mode;
+  float start, end, density;
+  float tx, tz, rot_y;  // modelview: Translate(tx, 0, tz) then Rotate(rot_y, 0, 1, 0)
+  float p[3];
+  float lo, hi;         // GL's factor (lo == hi unless off axis)
+};
+
+}  // namespace
+
+int main() {
+  RecordingDevice dev;
+  g::Context gl(&dev, 640, 480);
+  const float e1 = std::exp(-1.0f);
+  const Case cases[] = {
+      // eye (0, 0, -50): c = 50, (100 - 50) / 100
+      {"linear on axis", g::LINEAR, 0, 100, 1, 0, 0, 0, {0, 0, -50}, 0.5f, 0.5f},
+      // translated to eye (0, 0, -70): (120 - 70) / (120 - 20)
+      {"linear translated", g::LINEAR, 20, 120, 1, 0, -30, 0, {0, 0, -40}, 0.5f, 0.5f},
+      // the game's main-menu fog (start 0, end 7000)
+      {"linear game range", g::LINEAR, 0, 7000, 1, 0, 0, 0, {0, 0, -3500}, 0.5f, 0.5f},
+      // rotated: Ry(90) takes (50, 0, 0) to (0, 0, -50)
+      {"linear rotated", g::LINEAR, 0, 100, 1, 0, 0, 90, {50, 0, 0}, 0.5f, 0.5f},
+      // nearer than start: factor 1; beyond end: 0
+      {"linear near", g::LINEAR, 10, 100, 1, 0, 0, 0, {0, 0, -5}, 1, 1},
+      {"linear far", g::LINEAR, 0, 100, 1, 0, 0, 0, {0, 0, -150}, 0, 0},
+      // e^(-0.01 * 100) and e^(-(0.01 * 100)^2)
+      {"exp", g::EXP, 0, 1, 0.01f, 0, 0, 0, {0, 0, -100}, e1, e1},
+      {"exp2", g::EXP2, 0, 1, 0.01f, 0, 0, 0, {0, 0, -100}, e1, e1},
+      // (30, 0, -40): |z_e| = 40 gives 0.6, the distance 50 gives 0.5
+      {"linear off axis", g::LINEAR, 0, 100, 1, 0, 0, 0, {30, 0, -40}, 0.5f, 0.6f},
+  };
+  for (const Case& k : cases) {
+    gl.SetEnabled(g::FOG, true);
+    float mode = float(k.mode);
+    gl.Fog(g::FOG_MODE, &mode);
+    gl.Fog(g::FOG_START, &k.start);
+    gl.Fog(g::FOG_END, &k.end);
+    gl.Fog(g::FOG_DENSITY, &k.density);
+    gl.MatrixMode(g::MODELVIEW);
+    gl.LoadIdentity();
+    gl.Translate(k.tx, 0, k.tz);
+    if (k.rot_y != 0) gl.Rotate(k.rot_y, 0, 1, 0);
+    size_t before = dev.draws.size();
+    gl.Begin(g::POINTS);
+    gl.Vertex(k.p[0], k.p[1], k.p[2], 1);
+    gl.End();
+    if (dev.draws.size() != before + 1) {
+      std::printf("FAIL %s: %zu draws\n", k.name, dev.draws.size() - before);
+      g_failures++;
+      continue;
+    }
+    const auto& d = dev.draws.back();
+    Expect(k.name, d.rs.count(kFogEnable) && d.rs.at(kFogEnable) == 1);
+    Expect(k.name, d.rs.count(kFogTableMode) && d.rs.at(kFogTableMode) == 0);
+    float f = DeviceFog(d);
+    bool ok = f >= k.lo - 1e-4f && f <= k.hi + 1e-4f;
+    if (!ok) std::printf("FAIL %s: device factor %.6f, GL %.6f..%.6f\n", k.name, f, k.lo, k.hi);
+    g_failures += ok ? 0 : 1;
+  }
+  // Fog colour: RGB of GL_FOG_COLOR, each component * 255 rounded.
+  {
+    const float col[4] = {0.2f, 0.4f, 0.6f, 1.0f};
+    gl.Fog(g::FOG_COLOR, col);
+    gl.Begin(g::POINTS);
+    gl.Vertex(0, 0, -1, 1);
+    gl.End();
+    const auto& d = dev.draws.back();
+    uint32_t c = d.rs.count(kFogColor) ? d.rs.at(kFogColor) & 0xFFFFFF : 0;
+    if (c != 0x336699) {
+      std::printf("FAIL fog colour %06X, want 336699\n", c);
+      g_failures++;
+    }
+  }
+  // Disabled: the device's fog is off.
+  {
+    gl.SetEnabled(g::FOG, false);
+    gl.Begin(g::POINTS);
+    gl.Vertex(0, 0, -1, 1);
+    gl.End();
+    Expect("disabled", dev.draws.back().rs.count(kFogEnable) &&
+                           dev.draws.back().rs.at(kFogEnable) == 0);
+  }
+  std::printf("%d failures\n", g_failures);
+  return g_failures ? 1 : 0;
+}
