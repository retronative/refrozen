+// The loader's frame (kernel32_state.h, LoaderCatch). In the search pass it
+// unwinds the frames above it (their handlers run with the unwinding flag,
+// as RtlUnwind would) and leaves the guest call chain by throwing to
+// CallDllMain; in an unwind pass it has nothing to clean up.
+HLE_NAMED("kernel32.dll", "<loader_frame>", LoaderFrame, 4) {
+  uint32_t rec = Arg(c, 0), reg = Arg(c, 1);
+  if (Rd32(rec + 4) & (kExceptionUnwinding | kExceptionExitUnwind)) return kContinueSearch;
+  uint32_t teb = c.fs_base;
+  uint32_t saved_esp = c.esp;
+  c.esp -= 0x800;
+  uint32_t ctx = c.esp + 0x10;
+  FillContext(ctx, c, Rd32(saved_esp), saved_esp + 4 + 16);
+  Wr32(rec + 4, Rd32(rec + 4) | kExceptionUnwinding);
+  for (uint32_t r = Rd32(teb); r != kEnd && r && r != reg; r = Rd32(teb)) {
+    CallGuest(c, Rd32(r + 4), {rec, r, ctx, 0});
+    Wr32(teb, Rd32(r));
+  }
+  c.esp = saved_esp;
+  throw LoaderCatch{Rd32(rec)};
+}
