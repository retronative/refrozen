+// The GL context's texel precision (runtime/gl/context.h): what reaches
+// the device for glTexImage2D / glTexSubImage2D with sized internal formats.
+//
+// Formats storing fewer than 8 bits per component keep texels at that
+// precision. Expected values follow GL 1.5's conversion of a component to
+// n-bit fixed point, round(c / 255 * (2^n - 1)), read back as v / (2^n - 1)
+// on the 8-bit scale, worked out by hand in each case.
+
+#include <algorithm>
+#include <array>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <vector>
+
+#include "runtime/gl/context.h"
+#include "runtime/log.h"
+
+namespace recomp {
+bool g_trace = false;
+void FatalF(const char* fmt, ...) {
+  va_list a;
+  va_start(a, fmt);
+  std::vfprintf(stderr, fmt, a);
+  va_end(a);
+  std::abort();
+}
+void WarnF(const char*, ...) {}
+void TraceF(const char*, ...) {}
+}  // namespace recomp
+
+namespace {
+
+using namespace recomp;
+namespace g = recomp::gl;
+
+class RecordingDevice final : public gfx::Device {
+ public:
+  // The render states and transforms in effect at each draw.
+  struct DrawState {
+    std::map<uint32_t, uint32_t> rs;
+    std::array<float, 16> world, view;
+    std::vector<uint8_t> verts;
+    uint32_t stride;
+  };
+  std::vector<DrawState> draws;
+  std::map<uint32_t, uint32_t> rs;
+  std::map<uint32_t, std::array<float, 16>> xf;
+
+  void ResetSwapChain(int, int, bool) override {}
+  gfx::TextureId CreateTexture(int, int, int, gfx::Format, bool) override { return ++ids_; }
+  void DestroyTexture(gfx::TextureId) override {}
+  void FillTexture(gfx::TextureId, const gfx::Rect&, uint32_t) override {}
+  // The last upload: its bytes (A8R8G8B8, rows packed).
+  std::vector<uint8_t> uploaded;
+  void UpdateTexture(gfx::TextureId, int, const gfx::Rect& r, const void* src, uint32_t pitch) override {
+    const auto* s = static_cast<const uint8_t*>(src);
+    uploaded.clear();
+    for (int y = 0; y < r.bottom - r.top; y++)
+      uploaded.insert(uploaded.end(), s + size_t(y) * pitch, s + size_t(y) * pitch + size_t(r.right - r.left) * 4);
+  }
+  gfx::TextureId CreateCubeTexture(int, int, gfx::Format) override { return ++ids_; }
+  void UpdateCubeTexture(gfx::TextureId, int, int, const gfx::Rect&, const void*, uint32_t) override {}
+  gfx::DepthId CreateDepth(int, int, gfx::Format) override { return 1; }
+  void DestroyDepth(gfx::DepthId) override {}
+  void SetRenderTarget(gfx::TextureId, gfx::DepthId) override {}
+  void SetRenderTargets(const gfx::ColorTarget*, gfx::DepthId) override {}
+  void StretchRect(gfx::ColorTarget, const gfx::Rect&, gfx::ColorTarget, const gfx::Rect&, bool) override {}
+  gfx::ShaderId CreateShader(const hlsl::Program&) override { return 0; }
+  void DestroyShader(gfx::ShaderId) override {}
+  void DrawShader(const gfx::ShaderDraw&) override {}
+  void Blit(const void*, uint32_t, gfx::Format, const gfx::Rect&, const gfx::Rect&, bool,
+            uint32_t) override {}
+  void ReadBack(const gfx::Rect&, void*, uint32_t, gfx::Format) override {}
+  void BlitBlend(const void*, uint32_t, const gfx::Rect&, const gfx::Rect&) override {}
+  uint32_t StartReadBack(const gfx::Rect&) override { return 1; }
+  void FinishReadBack(uint32_t, void*, uint32_t, gfx::Format) override {}
+  void BlitFront(const void*, uint32_t, gfx::Format, const gfx::Rect&,
+                 const gfx::Rect&) override {}
+  void ReadBackFront(const gfx::Rect&, void*, uint32_t, gfx::Format) override {}
+  void PresentFront() override {}
+  void SetRenderState(uint32_t s, uint32_t v) override { rs[s] = v; }
+  void SetTextureStageState(uint32_t, uint32_t, uint32_t) override {}
+  void SetTexture(uint32_t, gfx::TextureId) override {}
+  void SetTransform(uint32_t t, const float* m) override { std::copy_n(m, 16, xf[t].begin()); }
+  void SetViewport(const gfx::Viewport&) override {}
+  void SetScissor(const gfx::Rect&) override {}
+  void SetMaterial(const gfx::Material&) override {}
+  void SetLight(uint32_t, const gfx::Light&) override {}
+  void LightEnable(uint32_t, bool) override {}
+  void SetClipPlane(uint32_t, const float*) override {}
+  void Clear(uint32_t, const gfx::Rect*, uint32_t, uint32_t, float, uint32_t) override {}
+  void BeginScene() override {}
+  void EndScene() override {}
+  void Draw(uint32_t, uint32_t, const void* v, uint32_t nv, uint32_t stride, const uint16_t*,
+            uint32_t) override {
+    auto* b = static_cast<const uint8_t*>(v);
+    draws.push_back({rs, xf[1], xf[2], {b, b + size_t(nv) * stride}, stride});
+  }
+  Mapped MapDraw(uint32_t nv, uint32_t stride, uint32_t ni) override {
+    map_v_.assign(size_t(nv) * stride, 0);
+    map_i_.assign(ni, 0);
+    map_stride_ = stride;
+    return {map_v_.data(), map_i_.data()};
+  }
+  void DrawMapped(uint32_t, uint32_t) override {
+    draws.push_back({rs, xf[1], xf[2], map_v_, map_stride_});
+  }
+  void Present() override {}
+
+ private:
+  uint32_t ids_ = 0;
+  std::vector<uint8_t> map_v_;
+  std::vector<uint16_t> map_i_;
+  uint32_t map_stride_ = 0;
+};
+
+
+int g_failures = 0;
+
+// One RGBA texel in, the A8R8G8B8 bytes (B, G, R, A) the device got.
+void Case(RecordingDevice& dev, g::Context& gl, const char* name, g::Enum internal,
+          std::array<uint8_t, 4> rgba, std::array<uint8_t, 4> want_rgba) {
+  gl.TexImage2D(g::TEXTURE_2D, 0, internal, 1, 1, 0, g::RGBA, g::UNSIGNED_BYTE, rgba.data());
+  std::array<uint8_t, 4> got{};
+  if (dev.uploaded.size() == 4) got = {dev.uploaded[2], dev.uploaded[1], dev.uploaded[0], dev.uploaded[3]};
+  if (got != want_rgba) {
+    std::printf("FAIL %s: got %d,%d,%d,%d want %d,%d,%d,%d\n", name, got[0], got[1], got[2], got[3],
+                want_rgba[0], want_rgba[1], want_rgba[2], want_rgba[3]);
+    g_failures++;
+  }
+}
+
+}  // namespace
+
+int main() {
+  RecordingDevice dev;
+  g::Context gl(&dev, 640, 480);
+  uint32_t name;
+  gl.GenTextures(1, &name);
+  gl.BindTexture(g::TEXTURE_2D, name);
+  // RGBA4: 191 -> round(191 * 15 / 255) = round(11.24) = 11 -> 11 * 17 = 187;
+  // 192 -> round(11.29) = 11 -> 187; 196 -> round(11.53) = 12 -> 204;
+  // 0 and 255 exact.
+  Case(dev, gl, "RGBA4", g::RGBA4, {191, 192, 0, 196}, {187, 187, 0, 204});
+  // RGB5_A1: alpha 127 -> round(127 / 255) = 0; 128 -> 1 -> 255. Colour 100 ->
+  // round(100 * 31 / 255) = round(12.16) = 12 -> round(12 * 255 / 31) =
+  // round(98.71) = 99; 200 -> round(24.31) = 24 -> round(197.42) = 197.
+  Case(dev, gl, "RGB5_A1 alpha 127", g::RGB5_A1, {100, 200, 255, 127}, {99, 197, 255, 0});
+  Case(dev, gl, "RGB5_A1 alpha 128", g::RGB5_A1, {100, 200, 255, 128}, {99, 197, 255, 255});
+  // RGB5: no alpha stored (reads as 1); 8 -> round(0.97) = 1 -> round(8.23) = 8;
+  // 3 -> round(0.36) = 0 -> 0.
+  Case(dev, gl, "RGB5", g::RGB5, {8, 3, 255, 10}, {8, 0, 255, 255});
+  // RGB4: 136 -> round(8) = 8 -> 136; 9 -> round(0.53) = 1 -> 17.
+  Case(dev, gl, "RGB4", g::RGB4, {136, 9, 0, 10}, {136, 17, 0, 255});
+  // RGBA8 and the unsized RGBA keep every bit.
+  Case(dev, gl, "RGBA8", g::RGBA8, {191, 1, 254, 127}, {191, 1, 254, 127});
+  Case(dev, gl, "RGBA", g::RGBA, {191, 1, 254, 127}, {191, 1, 254, 127});
+  // glTexSubImage2D keeps the image's sized format: RGB5_A1 alpha 128 -> 255.
+  gl.TexImage2D(g::TEXTURE_2D, 0, g::RGB5_A1, 1, 1, 0, g::RGBA, g::UNSIGNED_BYTE, nullptr);
+  const uint8_t px[4] = {100, 200, 255, 128};
+  gl.TexSubImage2D(g::TEXTURE_2D, 0, 0, 0, 1, 1, g::RGBA, g::UNSIGNED_BYTE, px);
+  std::array<uint8_t, 4> got{};
+  if (dev.uploaded.size() == 4) got = {dev.uploaded[2], dev.uploaded[1], dev.uploaded[0], dev.uploaded[3]};
+  if (got != std::array<uint8_t, 4>{99, 197, 255, 255}) {
+    std::printf("FAIL TexSubImage2D on RGB5_A1: got %d,%d,%d,%d\n", got[0], got[1], got[2], got[3]);
+    g_failures++;
+  }
+  std::printf("%d failures\n", g_failures);
+  return g_failures ? 1 : 0;
+}
