+    w.ur = std::max(w.ur, r), w.ub = std::max(w.ub, b);
+  } else {
+    w.dirty = true, w.ul = l, w.ut = t, w.ur = r, w.ub = b;
+  }
+  w.erase = w.erase || erase;
