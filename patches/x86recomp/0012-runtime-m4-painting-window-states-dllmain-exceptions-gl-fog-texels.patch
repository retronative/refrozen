+// RedrawWindow returns without effect for them).
+void InvalidateLocked(Window& w, int l, int t, int r, int b, bool erase) {
+  if (!w.visible || w.destroyed) return;
+  int cw, ch;
+  ClientSize(w, &cw, &ch);
