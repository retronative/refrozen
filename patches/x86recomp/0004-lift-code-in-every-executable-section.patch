diff --git a/src/runtime/pe_image.cpp b/src/runtime/pe_image.cpp
index c881f86..76dc612 100644
--- a/src/runtime/pe_image.cpp
+++ b/src/runtime/pe_image.cpp
@@ -214,4 +214,21 @@ bool PeImage::Load(const std::string& path, GuestMemory& mem,
   return true;
 }
 
+bool PeImage::CodeSpan(gaddr* lo, gaddr* hi) const {
+  constexpr uint32_t kScnMemExecute = 0x20000000;
+  gaddr l = 0, h = 0;
+  for (const auto& s : sections)
+    if (s.characteristics & kScnMemExecute) {
+      if (!h || s.va < l) l = s.va;
+      h = std::max(h, s.va + s.vsize);
+    }
+  if (!h) return false;
+  for (const auto& s : sections)
+    if (!(s.characteristics & kScnMemExecute) && s.va < h && s.va + s.vsize > l)
+      return false;
+  *lo = l;
+  *hi = h;
+  return true;
+}
+
 }  // namespace recomp
