+enum class BrushKind { Solid, Hollow, Unknown };
+// Solid: *color is the brush's COLORREF (0x00BBGGRR); Hollow: NULL_BRUSH,
+// which draws nothing; Unknown: not a brush this runtime can fill with.
+BrushKind BrushColor(uint32_t brush, uint32_t* color);
+
+}  // namespace recomp::hle
