+// GDI drawing. A window's DC has a surface of COLORREFs the size of its
+// client area, black until drawn on, shown through an SDL renderer on the
+// window (a texture of the whole surface, presented after each fill). The
+// game draws with GDI only in its movie backdrop and dialog paths
+// (FEASIBILITY §11): the backdrop is a FillRect with the black stock brush
+// behind a cinematic. Anything else stays a strict stop, never a silent
+// success: the screen DC (no pixels behind it), a window a graphics device
+// presents on (the two would fight over the window), a child window (no SDL
+// window of its own), a brush that is not solid, and text (DrawTextA).
+
+// The window's surface, sized to its client area (resized: cleared).
+std::vector<uint32_t>& GdiSurface(Window& w) {
+  int cw, ch;
+  ClientSize(w, &cw, &ch);
+  if (w.gdi_w != cw || w.gdi_h != ch) {
+    w.gdi_px.assign(size_t(cw) * size_t(ch), 0);
+    w.gdi_w = cw;
+    w.gdi_h = ch;
+    if (w.gdi_tex) SDL_DestroyTexture(w.gdi_tex);
+    w.gdi_tex = nullptr;
+  }
+  return w.gdi_px;
+}
+
+// Shows the surface on the window.
+void GdiPresent(Window& w) {
+  if (!w.gdi_r) {
+    w.gdi_r = SDL_CreateRenderer(w.sdl, nullptr);
+    if (!w.gdi_r) FatalF("SDL_CreateRenderer for GDI drawing on window %08X: %s", w.hwnd, SDL_GetError());
+  }
+  if (!w.gdi_tex) {
+    w.gdi_tex = SDL_CreateTexture(w.gdi_r, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, w.gdi_w, w.gdi_h);
+    if (!w.gdi_tex) FatalF("SDL_CreateTexture for GDI drawing on window %08X: %s", w.hwnd, SDL_GetError());
+  }
+  std::vector<uint32_t> argb(w.gdi_px.size());
+  for (size_t i = 0; i < argb.size(); i++) {
+    const uint32_t c = w.gdi_px[i];  // COLORREF 0x00BBGGRR -> 0xFFRRGGBB
+    argb[i] = 0xFF000000u | ((c & 0xFFu) << 16) | (c & 0xFF00u) | ((c >> 16) & 0xFFu);
+  }
+  SDL_UpdateTexture(w.gdi_tex, nullptr, argb.data(), w.gdi_w * 4);
+  SDL_RenderClear(w.gdi_r);
+  SDL_RenderTexture(w.gdi_r, w.gdi_tex, nullptr, nullptr);
+  SDL_RenderPresent(w.gdi_r);
+}
+
+// Fills (l,t)-(r,b) of hwnd's client area with `brush`, clipped to the
+// client area; the right and bottom edges are excluded (MSDN FillRect).
+// False for a window that is not open.
+bool GdiFillWindow(uint32_t hwnd, int32_t l, int32_t t, int32_t r, int32_t b, uint32_t brush, const char* who) {
+  uint32_t color = 0;
+  switch (BrushColor(brush, &color)) {
+    case BrushKind::Hollow: return true;  // NULL_BRUSH draws nothing
+    case BrushKind::Unknown: FatalF("%s: brush %08X is not a solid brush: not implemented", who, brush);
+    case BrushKind::Solid: break;
+  }
+  std::lock_guard<std::recursive_mutex> lk(g_mu);
+  Window* w = Win(hwnd);
+  if (!w || w->destroyed) return false;
+  if (w->gfx) FatalF("%s: GDI drawing on window %08X, which a graphics device presents on: not implemented", who, hwnd);
+  if (!w->sdl) FatalF("%s: GDI drawing on child window %08X is not implemented", who, hwnd);
+  std::vector<uint32_t>& px = GdiSurface(*w);
+  l = std::max(l, 0);
+  t = std::max(t, 0);
+  r = std::min(r, w->gdi_w);
+  b = std::min(b, w->gdi_h);
+  for (int32_t y = t; y < b; y++)
+    for (int32_t x = l; x < r; x++) px[size_t(y) * size_t(w->gdi_w) + size_t(x)] = color;
+  GdiPresent(*w);
+  return true;
+}
