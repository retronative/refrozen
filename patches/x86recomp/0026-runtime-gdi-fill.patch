+
+// The stock brushes' colours (MSDN GetStockObject): WHITE_BRUSH 0, LTGRAY_BRUSH
+// 1 (192), GRAY_BRUSH 2 (128), DKGRAY_BRUSH 3 (64), BLACK_BRUSH 4, NULL_BRUSH 5.
+// Stock objects are 0x00E00000 + index (indices below 0x20); NewGdi's handles
+// start at 0x00E00020.
+BrushKind BrushColor(uint32_t brush, uint32_t* color) {
+  if ((brush & 0xFFFFFFE0u) == 0x00E00000u) {
+    switch (brush & 0xFF) {
+      case 0: *color = 0xFFFFFFu; return BrushKind::Solid;
+      case 1: *color = 0xC0C0C0u; return BrushKind::Solid;
+      case 2: *color = 0x808080u; return BrushKind::Solid;
+      case 3: *color = 0x404040u; return BrushKind::Solid;
+      case 4: *color = 0x000000u; return BrushKind::Solid;
+      case 5: return BrushKind::Hollow;
+      default: return BrushKind::Unknown;
+    }
+  }
+  std::lock_guard<std::mutex> l(g_brush_mu);
+  auto it = g_brush_color.find(brush);
+  if (it == g_brush_color.end()) return BrushKind::Unknown;
+  *color = it->second;
+  return BrushKind::Solid;
+}
 }  // namespace recomp::hle
