+    PostCompletion(f->port.get(), uint32_t(r), f->key, ovl);
+    SetLastError(kErrorIoPending);
+    return 0;
+  }
+  if (!f->overlapped) lseek(f->fd, off + r, SEEK_SET);
+  if (out) Wr32(out, uint32_t(r));
+  return 1;
