+    Wr32(ovl + 4, 0);
+    SetLastError(kErrorHandleEof);
+    return 0;
+  }
+  Wr32(ovl + 0, 0);  // STATUS_SUCCESS
+  Wr32(ovl + 4, uint32_t(r));
+  uint32_t event = Rd32(ovl + 16);
+  if (event & ~1u) SignalEventHandle(event & ~1u, false);
+  if (f->overlapped && f->port && !(event & 1)) {
+    PostCompletion(f->port.get(), uint32_t(r), f->key, ovl);
+    SetLastError(kErrorIoPending);
+    return 0;
+  }
+  if (!f->overlapped) lseek(f->fd, off + r, SEEK_SET);
+  if (out) Wr32(out, uint32_t(r));
+  return 1;
