+  woc[2] = 2;  // wPid: MM_WAVE_MAPPER (the system's default output)
+  woc[4] = 1;  // vDriverVersion 1.0
+  std::memcpy(woc + 8, "Speakers", 8);
+  const uint32_t formats = 0x000FFFFF;  // every WAVE_FORMAT_* to 96 kHz 16-bit stereo
+  std::memcpy(woc + 40, &formats, 4);
