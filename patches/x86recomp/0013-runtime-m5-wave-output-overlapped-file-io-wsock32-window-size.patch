+// (hwo, pwh, cbwh)
+HLE("winmm.dll", waveOutPrepareHeader, 3) {
+  std::lock_guard<std::mutex> l(g_mu);
+  if (!Find(Arg(c, 0))) return kMmsyserrInvalHandle;
+  uint32_t hdr = Arg(c, 1);
+  if (!hdr || Arg(c, 2) < 32) return kMmsyserrInvalParam;
+  Wr32(hdr + 16, Rd32(hdr + 16) | kWhdrPrepared);
+  return kMmsyserrNoError;
+}
+
+HLE("winmm.dll", waveOutUnprepareHeader, 3) {
+  std::lock_guard<std::mutex> l(g_mu);
+  if (!Find(Arg(c, 0))) return kMmsyserrInvalHandle;
+  uint32_t hdr = Arg(c, 1);
+  if (!hdr || Arg(c, 2) < 32) return kMmsyserrInvalParam;
+  if (Rd32(hdr + 16) & kWhdrInQueue) return kWaverrStillPlaying;
+  Wr32(hdr + 16, Rd32(hdr + 16) & ~kWhdrPrepared);
+  return kMmsyserrNoError;
+}
+
+// (hwo, pwh, cbwh): the block's bytes go into the stream now.
+HLE("winmm.dll", waveOutWrite, 3) {
+  std::lock_guard<std::mutex> l(g_mu);
+  Device* d = Find(Arg(c, 0));
+  if (!d) return kMmsyserrInvalHandle;
+  uint32_t hdr = Arg(c, 1);
+  if (!hdr || Arg(c, 2) < 32) return kMmsyserrInvalParam;
+  uint32_t fl = Rd32(hdr + 16);
+  if (!(fl & kWhdrPrepared)) return kWaverrUnprepared;
+  if (fl & kWhdrInQueue) return kWaverrStillPlaying;
+  if (fl & (kWhdrBeginLoop | kWhdrEndLoop))
+    FatalF("waveOutWrite: looping blocks (WHDR_BEGINLOOP/ENDLOOP) are not implemented");
+  Wr32(hdr + 16, (fl & ~kWhdrDone) | kWhdrInQueue);
+  uint32_t data = Rd32(hdr), len = Rd32(hdr + 4);
+  if (len) {
+    SDL_PutAudioStreamData(d->stream, GPtr(data), int(len));
+    if (d->dump) std::fwrite(GPtr(data), 1, len, d->dump);
+  }
+  d->written += len;
+  d->queue.push_back({hdr, d->written});
+  g_cv.notify_all();
+  return kMmsyserrNoError;
+}
