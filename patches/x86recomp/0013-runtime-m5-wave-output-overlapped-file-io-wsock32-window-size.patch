+  Wr32(hdr + 16, Rd32(hdr + 16) & ~kWhdrPrepared);
+  return kMmsyserrNoError;
+}
+
+// (hwo, pwh, cbwh): the block's bytes go into the stream now.
+HLE("winmm.dll", waveOutWrite, 3) {
+  std::lock_guard<std::mutex> l(g_mu);
+  Device* d = Find(Arg(c, 0));
+  if (!d) return kMmsyserrInvalHandle;
+  uint32_t hdr = Arg(c, 1);
+  if (!hdr || Arg(c, 2) < 32) return kMmsyserrInvalParam;
+  uint32_t fl = Rd32(hdr + 16);
+  if (!(fl & kWhdrPrepared)) return kWaverrUnprepared;
+  if (fl & kWhdrInQueue) return kWaverrStillPlaying;
+  if (fl & (kWhdrBeginLoop | kWhdrEndLoop))
+    FatalF("waveOutWrite: looping blocks (WHDR_BEGINLOOP/ENDLOOP) are not implemented");
+  Wr32(hdr + 16, (fl & ~kWhdrDone) | kWhdrInQueue);
+  uint32_t data = Rd32(hdr), len = Rd32(hdr + 4);
+  if (len) {
+    SDL_PutAudioStreamData(d->stream, GPtr(data), int(len));
+    if (d->dump) std::fwrite(GPtr(data), 1, len, d->dump);
+  }
+  d->written += len;
+  d->queue.push_back({hdr, d->written});
+  g_cv.notify_all();
+  return kMmsyserrNoError;
+}
+
+// Stops playback and returns every queued block (WOM_DONE from the device
+// thread) before returning.
+HLE("winmm.dll", waveOutReset, 1) {
+  std::unique_lock<std::mutex> l(g_mu);
+  Device* d = Find(Arg(c, 0));
+  if (!d) return kMmsyserrInvalHandle;
+  SDL_ClearAudioStream(d->stream);
+  d->reset = true;
+  g_cv.notify_all();
+  if (std::this_thread::get_id() != d->host_id)
+    g_cv.wait(l, [d] { return !d->reset; });
+  return kMmsyserrNoError;
+}
+
+// (hwo, puDeviceID)
+HLE("winmm.dll", waveOutGetID, 2) {
+  std::lock_guard<std::mutex> l(g_mu);
+  if (!Find(Arg(c, 0))) return kMmsyserrInvalHandle;
+  if (!Arg(c, 1)) return kMmsyserrInvalParam;
+  Wr32(Arg(c, 1), 0);
+  return kMmsyserrNoError;
+}
+
+// Fails with WAVERR_STILLPLAYING while blocks are queued; otherwise the
+// handle is gone after WOM_CLOSE.
+HLE("winmm.dll", waveOutClose, 1) {
+  Device* d;
+  {
+    std::lock_guard<std::mutex> l(g_mu);
+    d = Find(Arg(c, 0));
+    if (!d) return kMmsyserrInvalHandle;
+    if (!d->queue.empty()) return kWaverrStillPlaying;
+    g_devices.erase(d->handle);
+    d->closing = true;
+    g_cv.notify_all();
+  }
+  // The device thread leaves its loop; the Device stays allocated, as that
+  // thread may still be reading it.
+  SDL_DestroyAudioStream(d->stream);
+  if (d->dump) std::fclose(d->dump);
+  Notify(c, *d, kWomClose, 0);
+  return kMmsyserrNoError;
 }
 
 }  // namespace
