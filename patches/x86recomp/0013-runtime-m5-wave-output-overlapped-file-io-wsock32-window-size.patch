+++ b/tests/fit_map_test.cpp
@@ -0,0 +1,67 @@
+// Presentation geometry (runtime/gfx/device.h): FitRect places a frame in an
+// output of another size with its aspect kept (bars, never stretched), and
+// FramePoint maps an output point back into the frame, which is how pointer
+// input reaches the game in a scaled, fullscreen or Retina window. Expected
+// values are worked by hand from that geometry: the fitted side is
+// round(other side * aspect), the bars split the rest (left/top gets the
+// floor), and a point maps through the rectangle and clamps to the frame.
+
+#include <cstdio>
+
+#include "runtime/gfx/device.h"
+
+namespace {
+
+int g_failures = 0;
+
+void Rect(const char* name, int sw, int sh, int dw, int dh, int l, int t, int r, int b) {
+  const recomp::gfx::Rect got = recomp::gfx::FitRect(sw, sh, dw, dh);
+  if (got.left != l || got.top != t || got.right != r || got.bottom != b) {
+    std::printf("FAIL %s: rect (%d,%d)-(%d,%d), want (%d,%d)-(%d,%d)\n", name, got.left, got.top,
+                got.right, got.bottom, l, t, r, b);
+    g_failures++;
+  }
+}
+
+void Point(const char* name, int sw, int sh, int dw, int dh, float x, float y, int fx, int fy) {
+  int gx, gy;
+  recomp::gfx::FramePoint(sw, sh, dw, dh, x, y, &gx, &gy);
+  if (gx != fx || gy != fy) {
+    std::printf("FAIL %s: (%g,%g) -> (%d,%d), want (%d,%d)\n", name, x, y, gx, gy, fx, fy);
+    g_failures++;
+  }
+}
+
+}  // namespace
+
+int main() {
+  // The same size: identity.
+  Rect("800x600 in 800x600", 800, 600, 800, 600, 0, 0, 800, 600);
+  Point("800x600 in 800x600: origin", 800, 600, 800, 600, 0.5f, 0.5f, 0, 0);
+  Point("800x600 in 800x600: last pixel", 800, 600, 800, 600, 799.9f, 599.9f, 799, 599);
+  // A Retina window: 800x600 points are 1600x1200 pixels, an exact 2x.
+  Rect("800x600 in 1600x1200", 800, 600, 1600, 1200, 0, 0, 1600, 1200);
+  Point("Retina 2x: centre", 800, 600, 1600, 1200, 800, 600, 400, 300);
+  Point("Retina 2x: last pixel", 800, 600, 1600, 1200, 1599, 1199, 799, 599);
+  // Fullscreen on a 1512x982-point screen (wider than 4:3): pillarbox.
+  // Width = 982 * 800 / 600 = 1309.3 -> 1309; bars (1512 - 1309) / 2 = 101.
+  Rect("800x600 in 1512x982", 800, 600, 1512, 982, 101, 0, 1410, 982);
+  Point("1512x982: frame origin", 800, 600, 1512, 982, 101, 0, 0, 0);
+  // (755.5 - 101) * 800 / 1309 = 400.0; 491 * 600 / 982 = 300.
+  Point("1512x982: centre", 800, 600, 1512, 982, 755.5f, 491, 400, 300);
+  // Over the left bar: x clamps to 0; 700 * 600 / 982 = 427.7.
+  Point("1512x982: left bar", 800, 600, 1512, 982, 50, 700, 0, 427);
+  Point("1512x982: bottom right", 800, 600, 1512, 982, 1500, 981.9f, 799, 599);
+  // 1920x1080: width 1080 * 4 / 3 = 1440, bars 240.
+  Rect("800x600 in 1920x1080", 800, 600, 1920, 1080, 240, 0, 1680, 1080);
+  Point("1920x1080: centre", 800, 600, 1920, 1080, 960, 540, 400, 300);
+  // A 2:1 window: width 500 * 4 / 3 = 666.7 rounds to 667; bars 333 split
+  // 166 left (the floor) and 167 right.
+  Rect("800x600 in 1000x500", 800, 600, 1000, 500, 166, 0, 833, 500);
+  // A taller window: letterbox. Height 800 * 3 / 4 = 600, bars 150.
+  Rect("800x600 in 800x900", 800, 600, 800, 900, 0, 150, 800, 750);
+  Point("800x900: top bar", 800, 600, 800, 900, 400, 100, 400, 0);
+  Point("800x900: centre", 800, 600, 800, 900, 400, 450, 400, 300);
+  std::printf("%d failures\n", g_failures);
+  return g_failures ? 1 : 0;
+}
