 constexpr uint32_t kWaveMapper = 0xFFFFFFFF;
+constexpr uint32_t kWaveFormatQuery = 0x1, kWaveAllowSync = 0x2, kWaveMapped = 0x4;
+constexpr uint32_t kCallbackTypeMask = 0x70000, kCallbackNull = 0, kCallbackFunction = 0x30000,
+                   kCallbackEvent = 0x50000;
+constexpr uint32_t kWomOpen = 0x3BB, kWomClose = 0x3BC, kWomDone = 0x3BD;
+// WAVEHDR.dwFlags
+constexpr uint32_t kWhdrDone = 0x1, kWhdrPrepared = 0x2, kWhdrBeginLoop = 0x4,
+                   kWhdrEndLoop = 0x8, kWhdrInQueue = 0x10;
+
+struct Device {
+  uint32_t handle = 0;
+  SDL_AudioStream* stream = nullptr;
+  uint32_t callback = 0, instance = 0, flags = 0;
+  // Blocks written and not yet returned: (WAVEHDR, stream byte count at
+  // its end).
+  std::deque<std::pair<uint32_t, uint64_t>> queue;
+  uint64_t written = 0;  // bytes put into the stream
+  uint32_t slack = 0;     // bytes SDL's resampler may hold back (16 frames)
+  bool reset = false;    // waveOutReset asked the device thread to return all blocks
+  bool closing = false;
+  Thread* thread = nullptr;
+  std::thread::id host_id;  // the device thread's host thread
+  FILE* dump = nullptr;
+};
+
+std::mutex g_mu;
+std::condition_variable g_cv;
+std::map<uint32_t, Device*> g_devices;
+uint32_t g_next_handle = 0x4D000010;
+
+void Notify(Ctx& c, Device& d, uint32_t msg, uint32_t p1) {
+  switch (d.flags & kCallbackTypeMask) {
+    case kCallbackFunction:  // (hwo, uMsg, dwInstance, dwParam1, dwParam2)
+      CallGuest(c, d.callback, {d.handle, msg, d.instance, p1, 0});
+      break;
+    case kCallbackEvent:
+      SignalEventHandle(d.callback, false);
+      break;
+    default:
+      break;
+  }
+}
+
+// The device thread: returns blocks the stream has consumed (or, after a
+// reset, all of them), oldest first.
+void Loop(Device* d) {
+  d->host_id = std::this_thread::get_id();
+  std::unique_lock<std::mutex> l(g_mu);
+  while (!d->closing) {
+    const int queued = d->stream ? SDL_GetAudioStreamQueued(d->stream) : 0;
+    const uint64_t consumed = d->written - uint64_t(queued > 0 ? queued : 0);
+    // SDL's resampler keeps a few frames of history queued until more data
+    // arrives, so the last block before a pause counts as consumed within
+    // `slack` bytes of its end.
+    if (!d->queue.empty() && (d->reset || d->queue.front().second <= consumed + d->slack)) {
+      uint32_t hdr = d->queue.front().first;
+      d->queue.pop_front();
+      Wr32(hdr + 16, (Rd32(hdr + 16) & ~kWhdrInQueue) | kWhdrDone);
+      l.unlock();
+      Notify(d->thread->ctx, *d, kWomDone, hdr);
+      l.lock();
+      continue;
+    }
+    if (d->reset && d->queue.empty()) {
+      d->reset = false;
+      g_cv.notify_all();
+    }
+    g_cv.wait_for(l, std::chrono::milliseconds(2));
+  }
+}
+
+Device* Find(uint32_t h) {
+  auto it = g_devices.find(h);
+  return it == g_devices.end() ? nullptr : it->second;
+}
+
+bool ValidDevice(uint32_t id) { return id == 0 || id == kWaveMapper; }
 
