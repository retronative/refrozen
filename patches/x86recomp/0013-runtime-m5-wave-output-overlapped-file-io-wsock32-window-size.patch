+  SDL_ClearAudioStream(d->stream);
+  d->reset = true;
+  g_cv.notify_all();
+  if (std::this_thread::get_id() != d->host_id)
+    g_cv.wait(l, [d] { return !d->reset; });
+  return kMmsyserrNoError;
+}
