+// files or pipes. GetConsoleMode on them fails as on Windows for a handle
+// that is not a console's (FALSE, ERROR_INVALID_HANDLE); the CRT's write
+// path then uses WriteFile, which the standard handles support.
+HLE("kernel32.dll", GetConsoleMode, 2) {
+  SetLastError(kErrorInvalidHandle);
+  return 0;
