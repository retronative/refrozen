+// GetAcceptExSockaddrs(buffer, receive length, local and remote area sizes,
+// &local, &local length, &remote, &remote length): pointers into AcceptEx's
+// areas (Wine's calculation).
+HLE_NAMED("mswsock.dll", "GetAcceptExSockaddrs", GetAcceptExSockaddrs, 8) {
+  uint32_t area = Arg(c, 0) + Arg(c, 1);
+  Wr32(Arg(c, 5), Rd32(area));
+  Wr32(Arg(c, 4), area + 4);
+  area += Arg(c, 2);
+  Wr32(Arg(c, 7), Rd32(area));
+  Wr32(Arg(c, 6), area + 4);
+  return 0;
+}
