+bool AssociateSocketWithPort(KObject* k, std::shared_ptr<KObject> port, uint32_t key, uint32_t* error) {
+  auto* o = static_cast<hle::SocketObject*>(k);
+  std::lock_guard<std::mutex> l(hle::g_mu);
+  if (o->closed) {
+    *error = win32::kErrorInvalidHandle;
+    return false;
+  }
+  if (o->port) {  // one association per handle
+    *error = win32::kErrorInvalidParameter;
+    return false;
+  }
+  o->port = std::move(port);
+  o->key = key;
+  return true;
+}
+
+// ReadFile(socket, buffer, length, -, overlapped) on a connected socket
+// associated with a completion port: FALSE with ERROR_IO_PENDING; the data,
+// or 0 bytes when the peer has closed its side, arrive as a completion.
+uint32_t SocketReadFile(uint32_t h, uint32_t buf, uint32_t n, uint32_t ovl) {
+  if (!ovl) FatalF("ReadFile on a socket without an OVERLAPPED is not implemented");
+  auto o = hle::SocketOf(h);
+  std::lock_guard<std::mutex> l(hle::g_mu);
+  if (!o || o->closed) {
+    hle::SetLastError(win32::kErrorInvalidHandle);
+    return 0;
+  }
+  if (!o->s.stream) FatalF("ReadFile on a datagram socket is not implemented");
+  if (!o->port) FatalF("overlapped ReadFile on a socket with no completion port is not implemented");
+  if ((n && !hle::Valid(buf, n)) || !hle::Valid(ovl, 20)) {
+    hle::SetLastError(998);  // ERROR_NOACCESS
+    return 0;
+  }
+  Wr32(ovl, hle::kStatusPending);
+  Wr32(ovl + 4, 0);
+  hle::Queue({false, o, nullptr, o->port, o->key, ovl, buf, n, 0, 0});
+  hle::SetLastError(win32::kErrorIoPending);
+  return 0;
+}
