+           rml = Arg(c, 5), out = Arg(c, 6), ovl = Arg(c, 7);
+  if (!ovl || !Valid(ovl, 20)) return SetLastError(87), 0;  // WSA_INVALID_PARAMETER
+  Wr32(ovl, kStatusPending);
+  Wr32(ovl + 4, 0);
+  if (!buf) return SetLastError(kWsaEinval), 0;
+  if (!rml) return SetLastError(kWsaEfault), 0;
+  if (rl) FatalF("AcceptEx receiving data with the connection is not implemented");
+  if (ll < 32 || rml < 32) FatalF("AcceptEx with an address area under 32 bytes is not implemented");
+  if (!Valid(buf, ll + rml)) return SetLastError(kWsaEfault), 0;
+  auto l = SocketOf(ls), a = SocketOf(as);
+  std::lock_guard<std::mutex> lock(g_mu);
+  if (!l || l->closed) return SetLastError(kWsaEnotsock), 0;
+  if (!l->s.listening) return SetLastError(kWsaEinval), 0;
+  if (!a || a->closed) return SetLastError(kWsaEnotsock), 0;
+  sockaddr_in peer;
+  socklen_t n = sizeof peer;
+  bool taken = false;
+  for (const Op& op : g_ops) taken |= op.target == a;
+  if (!a->s.stream || taken || ::getpeername(a->s.fd, reinterpret_cast<sockaddr*>(&peer), &n) == 0)
+    return SetLastError(kWsaEinval), 0;
+  if (!l->port) FatalF("AcceptEx on a socket with no completion port is not implemented");
+  if (out) Wr32(out, 0);
+  Queue({true, l, a, l->port, l->key, ovl, buf, rl, ll, rml});
+  SetLastError(win32::kErrorIoPending);
+  return 0;
+}
