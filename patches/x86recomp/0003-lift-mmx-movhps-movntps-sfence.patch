+// MMX onto runtime/lifted.h's recomp::mmx (the registers live in the x87
+// physical registers). Only the forms games were seen to use; any other
+// form is Unimplemented.
+void InsnEmitter::EmitMmx() {
+  const auto m = d_.mnemonic;
+  if (m == ZYDIS_MNEMONIC_EMMS) {
+    L("::recomp::mmx::Emms(c.fpu);");
+    return;
+  }
+  auto is_mm = [&](int i) {
+    return IsReg(i) && ZydisRegisterGetClass(Op(i).reg.value) == ZYDIS_REGCLASS_MMX;
+  };
+  auto mm = [&](int i) { return int(Op(i).reg.value - ZYDIS_REGISTER_MM0); };
+  // A 64-bit source: an MMX register or m64.
+  auto q = [&](int i) -> std::string {
+    if (is_mm(i)) return Fmt("::recomp::mmx::Get(c.fpu, %d)", mm(i));
+    if (IsMem(i) && Bytes(i) == 8) return Fmt("::recomp::lift::Rd<uint64_t>(B, m%d)", i);
+    return "";
+  };
+  const bool dst_mm = Nvis() >= 1 && is_mm(0);
+  std::string v;  // new value of MM(dst), when the destination is one
+  switch (m) {
+    case ZYDIS_MNEMONIC_MOVD:
+      if (dst_mm && !is_mm(1) && Bytes(1) == 4) break;
+      if (!dst_mm && is_mm(1) && Bytes(0) == 4) break;
+      return Unimpl();
+    case ZYDIS_MNEMONIC_MOVQ:
+      if (dst_mm && !q(1).empty()) break;
+      if (IsMem(0) && is_mm(1)) break;
+      return Unimpl();
+    case ZYDIS_MNEMONIC_PAND: case ZYDIS_MNEMONIC_PANDN:
+    case ZYDIS_MNEMONIC_POR: case ZYDIS_MNEMONIC_PXOR:
+    case ZYDIS_MNEMONIC_PADDUSB:
+    case ZYDIS_MNEMONIC_PACKSSDW: case ZYDIS_MNEMONIC_PACKSSWB:
+      if (dst_mm && !q(1).empty()) break;
+      return Unimpl();
+    case ZYDIS_MNEMONIC_PSLLQ: case ZYDIS_MNEMONIC_PSRLQ:
+    case ZYDIS_MNEMONIC_PSRAD: case ZYDIS_MNEMONIC_PSRAW:
+      if (dst_mm && (IsImm(1) || !q(1).empty())) break;
+      return Unimpl();
+    default:
+      return Unimpl();
+  }
+  if (!PrepareMem()) return Unimpl();
+  const std::string d = dst_mm ? Fmt("::recomp::mmx::Get(c.fpu, %d)", mm(0)) : "";
+  switch (m) {
+    case ZYDIS_MNEMONIC_MOVD:
+      if (dst_mm) {
+        v = Fmt("uint64_t(%s)", Read(1).c_str());
+      } else {
+        L("::recomp::mmx::Enter(c.fpu);");
+        L(Write(0, Fmt("uint32_t(::recomp::mmx::Get(c.fpu, %d))", mm(1))));
+        return;
+      }
+      break;
+    case ZYDIS_MNEMONIC_MOVQ:
+      if (dst_mm) {
+        v = q(1);
+      } else {
+        L("::recomp::mmx::Enter(c.fpu);");
+        L(Fmt("::recomp::lift::Wr<uint64_t>(B, m0, ::recomp::mmx::Get(c.fpu, %d));", mm(1)));
+        return;
+      }
+      break;
+    case ZYDIS_MNEMONIC_PAND: v = d + " & " + q(1); break;
+    case ZYDIS_MNEMONIC_PANDN: v = "~" + d + " & " + q(1); break;
+    case ZYDIS_MNEMONIC_POR: v = d + " | " + q(1); break;
+    case ZYDIS_MNEMONIC_PXOR: v = d + " ^ " + q(1); break;
+    case ZYDIS_MNEMONIC_PADDUSB:
+      v = Fmt("::recomp::mmx::Paddusb(%s, %s)", d.c_str(), q(1).c_str());
+      break;
+    case ZYDIS_MNEMONIC_PACKSSDW: case ZYDIS_MNEMONIC_PACKSSWB:
+      v = Fmt("::recomp::mmx::%s(%s, %s)",
+              m == ZYDIS_MNEMONIC_PACKSSDW ? "Packssdw" : "Packsswb", d.c_str(), q(1).c_str());
+      break;
+    case ZYDIS_MNEMONIC_PSLLQ: case ZYDIS_MNEMONIC_PSRLQ:
+    case ZYDIS_MNEMONIC_PSRAD: case ZYDIS_MNEMONIC_PSRAW: {
+      std::string n =
+          IsImm(1) ? "uint64_t(" + Hex(uint32_t(Op(1).imm.value.u & 0xFF)) + ")" : q(1);
+      const char* fn = m == ZYDIS_MNEMONIC_PSLLQ   ? "Sllq"
+                       : m == ZYDIS_MNEMONIC_PSRLQ ? "Srlq"
+                       : m == ZYDIS_MNEMONIC_PSRAD ? "Psrad"
+                                                   : "Psraw";
+      v = Fmt("::recomp::mmx::%s(%s, %s)", fn, d.c_str(), n.c_str());
+      break;
+    }
+    default:
+      return Unimpl();
+  }
+  L(Fmt("const uint64_t v = %s;", v.c_str()));
+  L("::recomp::mmx::Enter(c.fpu);");
+  L(Fmt("::recomp::mmx::Set(c.fpu, %d, v);", mm(0)));
+}
