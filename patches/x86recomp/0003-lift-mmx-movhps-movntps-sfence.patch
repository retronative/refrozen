+// MMX instructions: EMMS, or any operand in an MMX register. They read and
+// write the x87 registers and tags, so an x87 run cannot span one.
+bool UsesMmx(const ZydisDecodedInstruction& d, const ZydisDecodedOperand* ops) {
+  if (d.mnemonic == ZYDIS_MNEMONIC_EMMS) return true;
+  for (int i = 0; i < d.operand_count_visible; i++)
+    if (ops[i].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+        ZydisRegisterGetClass(ops[i].reg.value) == ZYDIS_REGCLASS_MMX)
+      return true;
+  return false;
+}
