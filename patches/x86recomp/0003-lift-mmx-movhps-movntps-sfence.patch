+// ---- MMX --------------------------------------------------------------------
+// The MMX registers are the significands of the x87 physical registers
+// R0..R7 (Intel SDM vol. 1, 9.5). Every MMX instruction except EMMS sets
+// TOP to 0 and tags all registers valid; writing MMi also sets Ri's sign
+// and exponent bits to ones. EMMS tags all registers empty. (The model
+// derives valid/zero/special tags from contents, so an FNSTENV between an
+// MMX instruction and EMMS would read 10 where hardware reads 00.)
+namespace mmx {
+
+[[gnu::always_inline]] inline void Enter(x87::State& s) {
+  s.top = 0;
+  s.empty = 0;
+}
+[[gnu::always_inline]] inline uint64_t Get(const x87::State& s, int i) {
+  return s.r[i].sig;
+}
+[[gnu::always_inline]] inline void Set(x87::State& s, int i, uint64_t v) {
+  s.r[i].sig = v;
+  s.r[i].se = 0xFFFF;
+}
+[[gnu::always_inline]] inline void Emms(x87::State& s) { s.empty = 0xFF; }
+
+// PSLLQ / PSRLQ: counts above 63 clear the register.
+[[gnu::always_inline]] inline uint64_t Sllq(uint64_t v, uint64_t n) {
+  return n > 63 ? 0 : v << n;
+}
+[[gnu::always_inline]] inline uint64_t Srlq(uint64_t v, uint64_t n) {
+  return n > 63 ? 0 : v >> n;
+}
+
+// PADDUSB: eight unsigned bytes added with saturation at 0xFF.
+inline uint64_t Paddusb(uint64_t a, uint64_t b) {
+  uint64_t r = 0;
+  for (int i = 0; i < 64; i += 8) {
+    uint32_t s = uint32_t((a >> i) & 0xFF) + uint32_t((b >> i) & 0xFF);
+    r |= uint64_t(s > 0xFF ? 0xFF : s) << i;
+  }
+  return r;
+}
+
+// PSRAD / PSRAW: arithmetic right shift of each dword / word; counts above
+// the lane width fill the lane with its sign bit.
+inline uint64_t Psrad(uint64_t v, uint64_t n) {
+  const int s = n > 31 ? 31 : int(n);
+  uint64_t r = 0;
+  for (int i = 0; i < 64; i += 32)
+    r |= uint64_t(uint32_t(int32_t(uint32_t(v >> i)) >> s)) << i;
+  return r;
+}
+inline uint64_t Psraw(uint64_t v, uint64_t n) {
+  const int s = n > 15 ? 15 : int(n);
+  uint64_t r = 0;
+  for (int i = 0; i < 64; i += 16)
+    r |= uint64_t(uint16_t(int16_t(uint16_t(v >> i)) >> s)) << i;
+  return r;
+}
+
+// PACKSSDW: the two signed dwords of a, then of b, saturated to words.
+// PACKSSWB: the four signed words of a, then of b, saturated to bytes.
+inline uint64_t Packssdw(uint64_t a, uint64_t b) {
+  uint64_t r = 0;
+  for (int i = 0; i < 4; i++) {
+    int32_t x = int32_t(uint32_t((i < 2 ? a : b) >> (32 * (i & 1))));
+    int32_t s = x > 32767 ? 32767 : x < -32768 ? -32768 : x;
+    r |= uint64_t(uint16_t(s)) << (16 * i);
+  }
+  return r;
+}
+inline uint64_t Packsswb(uint64_t a, uint64_t b) {
+  uint64_t r = 0;
+  for (int i = 0; i < 8; i++) {
+    int32_t x = int16_t(uint16_t((i < 4 ? a : b) >> (16 * (i & 3))));
+    int32_t s = x > 127 ? 127 : x < -128 ? -128 : x;
+    r |= uint64_t(uint8_t(s)) << (8 * i);
+  }
+  return r;
+}
+
+}  // namespace mmx
 }  // namespace recomp
 
