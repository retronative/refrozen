+// SSE2 packed-integer forms on runtime/simd64.h's 64-bit operations:
+// lane-local ones per 64-bit half; packs, unpacks and the word shuffles
+// combine halves as the SDM defines them.
+inline uint64_t Lo(const Xmm& x) { return Lane<uint64_t>(x, 0); }
+inline uint64_t Hi(const Xmm& x) { return Lane<uint64_t>(x, 1); }
+inline void SetHalves(Xmm& d, uint64_t lo, uint64_t hi) {
+  SetLane<uint64_t>(d, 0, lo);
+  SetLane<uint64_t>(d, 1, hi);
+}
+template <uint64_t (*F)(uint64_t, uint64_t)>
+inline void PerHalf(Xmm& d, const Xmm& s) {
+  SetHalves(d, F(Lo(d), Lo(s)), F(Hi(d), Hi(s)));
+}
+template <uint64_t (*F)(uint64_t, uint64_t)>
+inline void ShiftHalves(Xmm& d, uint64_t count) {
+  SetHalves(d, F(Lo(d), count), F(Hi(d), count));
+}
+// PACKSSDW, PACKUSWB: d's lanes, then s's.
+template <uint64_t (*F)(uint64_t, uint64_t)>
+inline void PackHalves(Xmm& d, const Xmm& s) {
+  SetHalves(d, F(Lo(d), Hi(d)), F(Lo(s), Hi(s)));
+}
+// PUNPCKL*/PUNPCKH*: the low (high) halves of d and s interleaved.
+template <typename T>
+inline void Unpack(Xmm& d, const Xmm& s, bool high) {
+  const uint64_t a = high ? Hi(d) : Lo(d), b = high ? Hi(s) : Lo(s);
+  SetHalves(d, simd::UnpackLow<T>(a, b), simd::UnpackHigh<T>(a, b));
+}
+// PSHUFLW / PSHUFHW: the words of one half of s shuffled, the other copied.
+inline void Pshuflw(Xmm& d, const Xmm& s, uint8_t imm) {
+  SetHalves(d, simd::Pshufw(Lo(s), imm), Hi(s));
+}
+inline void Pshufhw(Xmm& d, const Xmm& s, uint8_t imm) {
+  SetHalves(d, Lo(s), simd::Pshufw(Hi(s), imm));
+}
+
 }  // namespace recomp::sse
