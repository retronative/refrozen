diff --git a/src/runtime/simd64.h b/src/runtime/simd64.h
new file mode 100644
index 0000000..a5a9383
--- /dev/null
+++ b/src/runtime/simd64.h
@@ -0,0 +1,154 @@
+#pragma once
+// Packed-integer operations on one 64-bit group of lanes, as MMX defines
+// them (Intel SDM vol. 2). MMX instructions use them directly
+// (recomp::mmx); SSE2's 128-bit forms apply them to each 64-bit half or
+// combine halves (runtime/sse.h).
+
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+
+namespace recomp::simd {
+
+// r.lane[i] = f(a.lane[i], b.lane[i]) for lanes of type T (signed or not).
+template <typename T, typename F>
+inline uint64_t Map(uint64_t a, uint64_t b, F f) {
+  using U = std::make_unsigned_t<T>;
+  constexpr int kBits = 8 * sizeof(T);
+  uint64_t r = 0;
+  for (int i = 0; i < 64 / kBits; i++)
+    r |= uint64_t(U(f(T(U(a >> (kBits * i))), T(U(b >> (kBits * i)))))) << (kBits * i);
+  return r;
+}
+
+template <typename T>
+inline T Saturate(int64_t v) {
+  return v > std::numeric_limits<T>::max()   ? std::numeric_limits<T>::max()
+         : v < std::numeric_limits<T>::min() ? std::numeric_limits<T>::min()
+                                             : T(v);
+}
+
+// Wrapping, signed-saturating and unsigned-saturating add and subtract.
+template <typename T>
+inline uint64_t Add(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return T(x + y); });
+}
+template <typename T>
+inline uint64_t Sub(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return T(x - y); });
+}
+template <typename T>
+inline uint64_t AddSat(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return Saturate<T>(int64_t(x) + int64_t(y)); });
+}
+template <typename T>
+inline uint64_t SubSat(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return Saturate<T>(int64_t(x) - int64_t(y)); });
+}
+
+// PCMPEQB/W, PCMPGTW (signed): all ones where true.
+template <typename T>
+inline uint64_t CmpEq(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return T(x == y ? ~T(0) : T(0)); });
+}
+template <typename T>
+inline uint64_t CmpGt(uint64_t a, uint64_t b) {
+  return Map<T>(a, b, [](T x, T y) { return T(x > y ? ~T(0) : T(0)); });
+}
+
+// PMULLW / PMULHW: the low / high 16 bits of each signed word product.
+inline uint64_t Pmullw(uint64_t a, uint64_t b) {
+  return Map<int16_t>(a, b, [](int16_t x, int16_t y) { return int16_t(int32_t(x) * y); });
+}
+inline uint64_t Pmulhw(uint64_t a, uint64_t b) {
+  return Map<int16_t>(a, b, [](int16_t x, int16_t y) { return int16_t((int32_t(x) * y) >> 16); });
+}
+
+// PMADDWD: each dword = the sum of its two signed word products (only
+// 8000h * 8000h twice overflows, to 80000000h).
+inline uint64_t Pmaddwd(uint64_t a, uint64_t b) {
+  uint64_t r = 0;
+  for (int i = 0; i < 2; i++) {
+    int64_t s = 0;
+    for (int j = 0; j < 2; j++) {
+      const int k = 16 * (2 * i + j);
+      s += int64_t(int16_t(uint16_t(a >> k))) * int16_t(uint16_t(b >> k));
+    }
+    r |= uint64_t(uint32_t(s)) << (32 * i);
+  }
+  return r;
+}
+
+// Logical shifts of each lane; counts of the lane width or more clear it.
+template <typename T>
+inline uint64_t Shl(uint64_t v, uint64_t n) {
+  if (n >= 8 * sizeof(T)) return 0;
+  return Map<T>(v, 0, [n](T x, T) { return T(x << n); });
+}
+template <typename T>
+inline uint64_t Shr(uint64_t v, uint64_t n) {
+  if (n >= 8 * sizeof(T)) return 0;
+  return Map<T>(v, 0, [n](T x, T) { return T(x >> n); });
+}
+
+// PSLLQ / PSRLQ: counts above 63 clear the register.
+inline uint64_t Sllq(uint64_t v, uint64_t n) { return n > 63 ? 0 : v << n; }
+inline uint64_t Srlq(uint64_t v, uint64_t n) { return n > 63 ? 0 : v >> n; }
+
+// PSRAD / PSRAW: arithmetic right shift of each dword / word; counts above
+// the lane width fill the lane with its sign bit.
+inline uint64_t Psrad(uint64_t v, uint64_t n) {
+  const int s = n > 31 ? 31 : int(n);
+  return Map<int32_t>(v, 0, [s](int32_t x, int32_t) { return int32_t(x >> s); });
+}
+inline uint64_t Psraw(uint64_t v, uint64_t n) {
+  const int s = n > 15 ? 15 : int(n);
+  return Map<int16_t>(v, 0, [s](int16_t x, int16_t) { return int16_t(x >> s); });
+}
+
+// PADDUSB: eight unsigned bytes added with saturation at FFh.
+inline uint64_t Paddusb(uint64_t a, uint64_t b) { return AddSat<uint8_t>(a, b); }
+
+// Unpacks: the low (or high) half's lanes of a and b, interleaved a, b.
+template <typename T>
+inline uint64_t UnpackLow(uint64_t a, uint64_t b, bool high = false) {
+  using U = std::make_unsigned_t<T>;
+  constexpr int kBits = 8 * sizeof(T), kHalf = 32 / kBits;
+  uint64_t r = 0;
+  for (int i = 0; i < kHalf; i++) {
+    const int src = kBits * (i + (high ? kHalf : 0));
+    r |= uint64_t(U(a >> src)) << (kBits * 2 * i);
+    r |= uint64_t(U(b >> src)) << (kBits * (2 * i + 1));
+  }
+  return r;
+}
+template <typename T>
+inline uint64_t UnpackHigh(uint64_t a, uint64_t b) { return UnpackLow<T>(a, b, true); }
+
+// Packs: the lanes of a, then of b, each saturated to half its width.
+// PACKSSDW: signed dwords to signed words. PACKSSWB: signed words to
+// signed bytes. PACKUSWB: signed words to unsigned bytes.
+template <typename From, typename To>
+inline uint64_t Pack(uint64_t a, uint64_t b) {
+  using UF = std::make_unsigned_t<From>;
+  using UT = std::make_unsigned_t<To>;
+  constexpr int kFrom = 8 * sizeof(From), kTo = 8 * sizeof(To), kN = 64 / kFrom;
+  uint64_t r = 0;
+  for (int i = 0; i < 2 * kN; i++) {
+    const From x = From(UF((i < kN ? a : b) >> (kFrom * (i % kN))));
+    r |= uint64_t(UT(Saturate<To>(x))) << (kTo * i);
+  }
+  return r;
+}
+inline uint64_t Packssdw(uint64_t a, uint64_t b) { return Pack<int32_t, int16_t>(a, b); }
+inline uint64_t Packsswb(uint64_t a, uint64_t b) { return Pack<int16_t, int8_t>(a, b); }
+inline uint64_t Packuswb(uint64_t a, uint64_t b) { return Pack<int16_t, uint8_t>(a, b); }
+
+// PSHUFW: word i of the result = word (imm >> 2i) & 3 of v.
+inline uint64_t Pshufw(uint64_t v, uint8_t imm) {
+  uint64_t r = 0;
+  for (int i = 0; i < 4; i++) r |= ((v >> (16 * ((imm >> (2 * i)) & 3))) & 0xFFFF) << (16 * i);
+  return r;
+}
+
+}  // namespace recomp::simd
