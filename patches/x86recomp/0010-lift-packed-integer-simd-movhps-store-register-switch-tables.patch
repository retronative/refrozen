+// the MMX forms (one 64-bit group) and the SSE2 forms (per 64-bit half, or
+// packed across halves: `pack`).
+struct PackedOp {
+  ZydisMnemonic m;
+  const char* fn;
+  bool pack;
+};
+const PackedOp kPackedOps[] = {
+    {ZYDIS_MNEMONIC_PADDW, "Add<uint16_t>", false},
+    {ZYDIS_MNEMONIC_PADDD, "Add<uint32_t>", false},
+    {ZYDIS_MNEMONIC_PADDSW, "AddSat<int16_t>", false},
+    {ZYDIS_MNEMONIC_PADDUSW, "AddSat<uint16_t>", false},
