+    {ZYDIS_MNEMONIC_PMADDWD, "Pmaddwd", false},
+    {ZYDIS_MNEMONIC_PACKUSWB, "Packuswb", true},
+    {ZYDIS_MNEMONIC_PACKSSDW, "Packssdw", true},
+};
+const PackedOp* FindPackedOp(ZydisMnemonic m) {
+  for (const PackedOp& op : kPackedOps)
+    if (op.m == m) return &op;
+  return nullptr;
+}
+
+// PUNPCKL*/PUNPCKH*: (lane type, high half).
+bool UnpackOp(ZydisMnemonic m, const char** type, bool* high) {
+  switch (m) {
+    case ZYDIS_MNEMONIC_PUNPCKLBW: *type = "uint8_t"; *high = false; return true;
+    case ZYDIS_MNEMONIC_PUNPCKLWD: *type = "uint16_t"; *high = false; return true;
+    case ZYDIS_MNEMONIC_PUNPCKLDQ: *type = "uint32_t"; *high = false; return true;
+    case ZYDIS_MNEMONIC_PUNPCKHBW: *type = "uint8_t"; *high = true; return true;
+    case ZYDIS_MNEMONIC_PUNPCKHWD: *type = "uint16_t"; *high = true; return true;
+    case ZYDIS_MNEMONIC_PUNPCKHDQ: *type = "uint32_t"; *high = true; return true;
+    default: return false;
+  }
+}
+
+// PSLLW/PSLLD/PSRLW/PSRLD/PSRAW (by an immediate or a 64-bit count): the
+// simd64.h function.
+const char* ShiftOp(ZydisMnemonic m) {
+  switch (m) {
+    case ZYDIS_MNEMONIC_PSLLW: return "Shl<uint16_t>";
+    case ZYDIS_MNEMONIC_PSLLD: return "Shl<uint32_t>";
+    case ZYDIS_MNEMONIC_PSRLW: return "Shr<uint16_t>";
+    case ZYDIS_MNEMONIC_PSRLD: return "Shr<uint32_t>";
+    case ZYDIS_MNEMONIC_PSRAW: return "Psraw";
+    default: return nullptr;
+  }
+}
