+    overlapped_ = true;
+  UpdateGap(it);
+  if (++it != regions_.end()) UpdateGap(it);
+}
+
+void GuestAllocator::Erase(Regions::iterator it) {
+  gaps_.erase(it->first);
+  it = regions_.erase(it);
